#!/usr/bin/env python3
"""Validate the # yaml-tasks fenced block inside a refine-plan plan.md.

Usage:
    validate-yaml-tasks <plan.md>

Exits:
    0  — block is valid; prints "OK: yaml-tasks valid (key=..., slices=N)"
    1  — block missing or invalid; prints "FAIL:\\n  - <issue>" lines
    2  — usage error or PyYAML missing

The validator is intentionally separate from the contract emitter so it can be
run as a fast pre-check before any reviewer subagent spawns. Output is
machine-parseable: SKILL.md captures the FAIL block and forwards it to the
task_planner subagent as revision instructions on the next BRC cycle.
"""

from __future__ import annotations

import re
import sys

try:
    import yaml
except ImportError:
    print("FAIL: PyYAML not installed (try: python3 -m pip install pyyaml)", file=sys.stderr)
    sys.exit(2)

FENCE_RE = re.compile(
    r"```(?:yaml|yml)\s*\n\s*#\s*yaml-tasks\s*\n(.*?)```",
    re.DOTALL,
)
TASK_ID_RE = re.compile(r"^TASK-\d+-\d+$", re.IGNORECASE)
SLICE_NUMBER_RE = re.compile(r"^(?:slice-|phase-)?(\d+)$", re.IGNORECASE)
DEP_TOKEN_RE = re.compile(r"(?:slice|phase)\s*(\d+)", re.IGNORECASE)


def _slice_canonical(raw_id: object) -> str | None:
    """Normalise slice id to ``slice-<N>`` for collision detection."""
    if raw_id is None:
        return None
    s = str(raw_id).strip()
    if not s:
        return None
    m = SLICE_NUMBER_RE.match(s)
    if not m:
        return None
    return f"slice-{m.group(1)}"


def _normalise_dep(raw: object) -> str | None:
    """Normalise a dependency entry to ``slice-<N>``.

    Mirrors ``emit-contract::_normalise_dep`` so the validator catches
    mis-wired ``dependencies`` / ``serialized_chain_order`` entries before
    the emitter silently drops them.
    """
    if raw is None:
        return None
    s = str(raw).strip()
    if not s:
        return None
    sl = s.lower()
    if sl.startswith("slice-"):
        return "slice-" + s[len("slice-") :]
    if sl.startswith("phase-"):
        return "slice-" + s[len("phase-") :]
    m = DEP_TOKEN_RE.search(s)
    if not m and len(s) <= 10:
        m = re.search(r"^\s*(\d+)\s*$", s)
    if m:
        return f"slice-{m.group(1)}"
    return None
VALID_ROLES = {"coder", "tester", "documenter"}
# Mirrors .egg/schemas/yaml-tasks.schema.json: only `pr.title` is required;
# description/test_plan/manual_steps are optional. shared/egg_contracts/
# plan_parser.py:extract_pr_metadata_from_yaml emits a warning (not an error)
# when test_plan is missing — we follow suit so a plan that /sdlc would accept
# does not get NACK'd forever in the local loop.
REQUIRED_PR_KEYS = ("title",)
RECOMMENDED_PR_KEYS = ("test_plan",)
REQUIRED_TASK_FIELDS = ("description", "acceptance")


def validate(plan_path: str) -> tuple[int, list[str], list[str]]:
    """Return (exit_code, errors, warnings).

    Errors fail the validation; warnings are surfaced for human attention but
    do not fail the run. Mirrors plan_parser.py's split between fatal and
    advisory issues.
    """
    try:
        with open(plan_path) as f:
            plan = f.read()
    except OSError as e:
        return 1, [f"could not read {plan_path}: {e}"], []

    m = FENCE_RE.search(plan)
    if not m:
        return 1, ["no '# yaml-tasks' fenced block found"], []

    try:
        data = yaml.safe_load(m.group(1))
    except yaml.YAMLError as e:
        return 1, [f"YAML parse error: {e}"], []

    if not isinstance(data, dict):
        return 1, ["top-level is not a mapping"], []

    if "slices" in data:
        tlk = "slices"
    elif "phases" in data:
        tlk = "phases"
    else:
        return 1, ["missing 'slices' or 'phases' top-level key"], []

    errors: list[str] = []
    warnings: list[str] = []
    if not isinstance(data[tlk], list) or not data[tlk]:
        errors.append(f"'{tlk}' must be a non-empty list")

    seen_task_ids: set[str] = set()
    seen_slice_ids: set[str] = set()
    dep_refs: list[tuple[object, str, object]] = []
    for sl in data.get(tlk) or []:
        if not isinstance(sl, dict):
            errors.append(f"non-mapping entry under '{tlk}': {sl!r}")
            continue
        slice_id = sl.get("id", "<missing>")
        canonical = _slice_canonical(slice_id)
        if canonical is None:
            errors.append(
                f"slice {slice_id!r}: id must be an integer or "
                "'slice-N'/'phase-N' (case-insensitive)"
            )
        else:
            if canonical in seen_slice_ids:
                errors.append(
                    f"duplicate slice id {slice_id!r} (canonical {canonical!r})"
                )
            seen_slice_ids.add(canonical)
        for field in ("dependencies", "serialized_chain_order"):
            raw = sl.get(field, [])
            if isinstance(raw, str):
                raw = [d.strip() for d in raw.split(",") if d.strip()]
            elif not isinstance(raw, list):
                errors.append(
                    f"slice {slice_id}: '{field}' must be a list or comma string"
                )
                continue
            for entry in raw:
                dep_refs.append((slice_id, field, entry))
        for t in sl.get("tasks") or []:
            tid = str(t.get("id", "")) if isinstance(t, dict) else ""
            if not TASK_ID_RE.match(tid):
                errors.append(f"slice {slice_id}: bad task id {t.get('id')!r}")
            else:
                # Normalize to the lowercase contract id (task-P-N) used
                # downstream so duplicates that differ only in case are caught.
                # Mirrors plan_parser.py's seen_contract_ids check (#1988).
                contract_id = tid.lower()
                if contract_id in seen_task_ids:
                    errors.append(
                        f"duplicate task id {contract_id!r} "
                        f"(source id {tid!r})"
                    )
                seen_task_ids.add(contract_id)
            role = t.get("role") if isinstance(t, dict) else None
            if role is not None and role not in VALID_ROLES:
                errors.append(
                    f"task {tid}: bad role {role!r} (must be one of {sorted(VALID_ROLES)})"
                )
            for fld in REQUIRED_TASK_FIELDS:
                if not (isinstance(t, dict) and t.get(fld)):
                    errors.append(f"task {tid}: missing {fld}")

    for src_slice, field, entry in dep_refs:
        norm = _normalise_dep(entry)
        if norm is None:
            errors.append(
                f"slice {src_slice}: {field} entry {entry!r} is not a "
                "valid slice reference"
            )
        elif norm not in seen_slice_ids:
            errors.append(
                f"slice {src_slice}: {field} references unknown slice {norm!r} "
                f"(from entry {entry!r}); defined slices: {sorted(seen_slice_ids)}"
            )

    pr = data.get("pr")
    if pr is None:
        # PR block is optional in the canonical schema.
        pass
    elif not isinstance(pr, dict):
        errors.append("'pr' block must be a mapping")
    else:
        for k in REQUIRED_PR_KEYS:
            if not pr.get(k):
                errors.append(f"pr.{k} missing or empty")
        for k in RECOMMENDED_PR_KEYS:
            if not pr.get(k):
                warnings.append(f"pr.{k} missing (recommended)")

    if errors:
        return 1, errors, warnings

    slice_count = len(data[tlk])
    return 0, [f"yaml-tasks valid (key={tlk}, slices={slice_count})"], warnings


def main(argv: list[str]) -> int:
    if len(argv) != 2:
        print(f"usage: {argv[0]} <plan.md>", file=sys.stderr)
        return 2
    code, messages, warnings = validate(argv[1])
    if code == 0:
        print(f"OK: {messages[0]}")
    else:
        print("FAIL:")
        for m in messages:
            print(f"  - {m}")
    for w in warnings:
        print(f"WARN: {w}")
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv))
