# Egg Secrets Template
# Copy this to ~/.config/egg/secrets.env and fill in your values
# IMPORTANT: This file contains sensitive credentials - DO NOT COMMIT
#
# File permissions should be 600 (readable only by owner):
#   chmod 600 ~/.config/egg/secrets.env

# =============================================================================
# Anthropic API (Claude)
# =============================================================================
# Choose ONE of the following authentication methods:
#
# Option 1: API Key (for Anthropic API accounts)
#   Get your API key from https://console.anthropic.com/settings/keys
#   Format: sk-ant-api03-...
#
# Option 2: OAuth Token (for Claude Max subscriptions)
#   Run: claude auth status --json | jq -r '.oauthToken'
#   Or find in: ~/.claude.json under "oauthToken"
#   Note: OAuth tokens expire and need periodic refresh
#
# If both are set, OAuth token takes precedence.

ANTHROPIC_API_KEY=""
ANTHROPIC_OAUTH_TOKEN=""

# =============================================================================
# LiteLLM Proxy (Optional — non-Claude model routing, issue #2769)
# =============================================================================
# Master key the gateway injects as ``x-api-key`` on every request routed
# through the in-cluster LiteLLM proxy. The same value is consumed by the
# LiteLLM Deployment via the ``gateway-secrets`` Secret (key
# ``litellm-master-key``) so both sides of the wire agree.
#
# ``OPENROUTER_API_KEY`` is wired end-to-end out of the box (issue
# #2799): ``make k3s-secrets`` extracts it from this file onto
# ``gateway-secrets`` as a literal key, and the LiteLLM Deployment binds
# it as an env var via ``secretKeyRef`` (``optional: true`` so
# deployments without that backend still start). Adding any other
# provider key (e.g. ``TOGETHER_API_KEY``) is NOT automatic — operators
# must (1) add an extraction line for the new key in the ``k3s-secrets``
# Makefile target and (2) add a matching ``secretKeyRef`` env entry on
# the LiteLLM container in ``k8s/base/litellm-deployment.yaml``. Without
# both edits, ``os.environ/<NEW_KEY>`` in ``litellm-models.yaml``
# resolves to an empty string at request time and the provider returns
# silent 401s. The gateway pod still does not consume these provider
# keys directly — they pass through ``secrets.env`` purely as the
# operator-facing entry point.
#
# Leave LITELLM_MASTER_KEY empty to disable LiteLLM routing — no agent
# will be routed to LiteLLM with this unset, regardless of any
# per-pipeline ``agent_models`` override. The Claude path is
# byte-identical.

LITELLM_MASTER_KEY=""

# OpenRouter API key (issue #2799) — consumed by the LiteLLM Deployment
# to authenticate ``openrouter/*`` model entries in
# ``litellm-configmap.yaml`` against openrouter.ai. Leave empty for a
# no-op default — the manifest reads ``gateway-secrets`` with
# ``optional: true``, so the LiteLLM pod starts cleanly without an
# OpenRouter backend configured. Populate this when wiring an
# ``openrouter/*`` model entry into the LiteLLM ConfigMap.

OPENROUTER_API_KEY=""

# =============================================================================
# Slack Integration
# =============================================================================
# Create a Slack app at https://api.slack.com/apps
# Enable Socket Mode and get an App-Level Token

# Bot token (starts with xoxb-)
SLACK_TOKEN=""

# App-level token for Socket Mode (starts with xapp-)
SLACK_APP_TOKEN=""

# =============================================================================
# GitHub Integration
# =============================================================================
# Egg supports multiple types of GitHub tokens:
#
# 1. GITHUB_TOKEN - For writable repos (full access)
#    Create a fine-grained token at https://github.com/settings/tokens?type=beta
#    Required permissions: Contents (R/W), Pull requests (R/W), Workflows (R)
#    OR configure a GitHub App (recommended) - run ./setup.py for guided setup
#
# 2. GITHUB_READONLY_TOKEN - For read-only repos (optional)
#    Used when monitoring repos where egg doesn't have write access
#    Create a fine-grained token with READ-ONLY permissions:
#    - Contents: Read-only
#    - Pull requests: Read-only
#    - Commit statuses: Read-only
#    Scope to the specific repos you want to monitor (e.g., org/webapp)
#
# 3. GITHUB_USER_TOKEN - For user mode (optional)
#    A Personal Access Token (PAT) for your personal GitHub account.
#    When a repo has auth_mode: user in repositories.yaml, git/gh
#    operations will use this token instead of the bot token, attributing
#    commits and PRs to your personal account.
#    Create a fine-grained PAT at https://github.com/settings/tokens?type=beta
#    Required permissions: Contents (R/W), Pull requests (R/W)
#    Scope to the specific repos you want to contribute to in user mode.

GITHUB_TOKEN=""
GITHUB_READONLY_TOKEN=""
GITHUB_USER_TOKEN=""

# =============================================================================
# Gateway Policy Configuration (REQUIRED)
# =============================================================================
# These configure the gateway sidecar's policy enforcement.
# The gateway will fail to start if these are not configured.

# Bot name - REQUIRED - must match your GitHub App name for PR ownership checks
# The gateway uses this to identify which PRs were created by the bot.
# If using a GitHub App named "my-bot", set GATEWAY_BOT_NAME="my-bot"
# The gateway will recognize authors: my-bot, my-bot[bot], app/my-bot, apps/my-bot
GATEWAY_BOT_NAME=""

# Branch prefix - REQUIRED - for bot-owned branches (branches the bot can push to)
# Example: "my-bot" allows branches like my-bot-feature, my-bot/feature
GATEWAY_BOT_BRANCH_PREFIX=""

# Trusted GitHub usernames whose branches the bot can push to (optional)
# Comma-separated list of usernames (case-insensitive)
# Example: GATEWAY_TRUSTED_USERS="alice,bob"
GATEWAY_TRUSTED_USERS=""

# =============================================================================
# Atlassian Cloud Integration (Jira + Confluence) — Recommended
# =============================================================================
# Atlassian accounts are tenant-wide.  A single bot account with read scopes
# on both Jira and Confluence covers the gateway's read-only wrappers.
#
# Get an API token from https://id.atlassian.com/manage-profile/security/api-tokens
#
# When set, ATLASSIAN_* takes precedence over JIRA_* / CONFLUENCE_* per key
# (the loader checks each key independently, so partial migrations work).
# Confluence Cloud lives at <ATLASSIAN_BASE_URL>/wiki — the gateway appends
# /wiki automatically when ATLASSIAN_BASE_URL is set and CONFLUENCE_BASE_URL
# is unset.

ATLASSIAN_BASE_URL=""   # e.g., https://yourcompany.atlassian.net (no trailing slash)
ATLASSIAN_USERNAME=""   # Atlassian account email
ATLASSIAN_API_TOKEN=""  # Atlassian Cloud API token

# =============================================================================
# Confluence Integration (Optional, legacy per-service triple)
# =============================================================================
# Back-compat fallback — used per-key when the matching ATLASSIAN_* is unset.
# Consumed by gateway/confluence_credentials.py.  The space allowlist lives
# in config/context-filters.yaml under confluence.spaces.

CONFLUENCE_BASE_URL=""  # e.g., https://yourcompany.atlassian.net/wiki
CONFLUENCE_USERNAME=""  # Your email
CONFLUENCE_API_TOKEN=""
# CONFLUENCE_SPACE_KEYS removed — space allowlist now lives in
# config/context-filters.yaml :: confluence.spaces (decision H1, issue #1931).

# =============================================================================
# JIRA Integration (Optional, legacy per-service triple)
# =============================================================================
# Back-compat fallback — used per-key when the matching ATLASSIAN_* is unset.
# Consumed by gateway/jira_credentials.py — sandboxed agents reach Jira
# through the gateway's /api/v1/jira/* endpoints; these credentials are
# never exported to the sandbox.
#
# Project allowlist lives in config/context-filters.yaml under jira.projects.
# Editing either file picks up via `POST /api/v1/config/reload` — no gateway
# restart required.

JIRA_BASE_URL=""  # e.g., https://yourcompany.atlassian.net  (no trailing slash)
JIRA_USERNAME=""  # Atlassian account email
JIRA_API_TOKEN=""
