# Repository Configuration for egg (user file, post-#2073).
#
# This is a TEMPLATE file. Copy to ~/.config/egg/repositories.yaml and
# customize. Or run ./setup.py which will create this file
# interactively.
#
# Layered config model (issue #2073):
# - Per-repo defaults (build_commands, persist, watch_files, checks,
#   auth_mode, checkpoint_repo, template) belong in
#   `<repo>/.egg/repositories.yaml` checked into the source repo.
#   Onboard new repos with the `/onboard-repo` skill in Claude Code,
#   which detects build commands / persist paths and writes the file.
# - This file carries operator-scoped fields only — github username,
#   bot username, the writable_repos / readable_repos lists,
#   local_repos.paths, default_reviewer, github_sync, user_mode,
#   docker_setup.extra_packages, plus optional per-repo OVERRIDES
#   under `repo_settings:` (use sparingly — most blocks should live
#   in the repo file).
# - Validate this file with: python3 scripts/validate-config.py
#   --repo-config <path-to-checkout>
#
# Schema reference: docs/guides/repo-config.md
# Internal manifest format (manifest.json) is unchanged from pre-#2073;
# the host-side classifier produces the legacy two-list shape so
# existing sandbox images keep working without rebuild.

schemaVersion: "1.0"

# ---------------------------------------------------------------------
# Operator identity
# ---------------------------------------------------------------------

# Your GitHub username (set by setup.py).
github_username: YOUR_USERNAME

# Bot username — the bot's GitHub identity for filtering out its own
# comments. Comments from this user are ignored (so the bot doesn't
# respond to itself).
bot_username: YOUR_BOT_USERNAME

# Default reviewer for PRs created by egg (defaults to github_username).
default_reviewer: YOUR_USERNAME

# ---------------------------------------------------------------------
# Repository access
# ---------------------------------------------------------------------

# Repositories where egg has WRITE access:
#   - Respond to PR comments
#   - Push code changes
#   - Create PRs via gh CLI
#   - Implement fixes for failed CI checks
writable_repos:
  - YOUR_USERNAME/egg
  # - YOUR_USERNAME/other-repo

# Repositories with read-only access:
#   - Sync and analyze PRs, comments, and check failures
#   - Send Slack notifications with feedback/analysis
#   - NOT: Push code, create PRs, post comments, or make any
#     modifications.
# Read-only repos only require a GitHub PAT with read access
# (GITHUB_READONLY_TOKEN).
readable_repos: []

# GitHub sync configuration.
github_sync:
  # Sync all PRs in writable repos (true) or just the user's PRs (false).
  sync_all_prs: true
  # Sync interval in minutes (used by the systemd timer).
  sync_interval_minutes: 5

# ---------------------------------------------------------------------
# Per-repo overrides (most blocks should live in
# <repo>/.egg/repositories.yaml — only override here when the operator
# wants to layer custom values on top of the repo defaults)
# ---------------------------------------------------------------------

repo_settings:
  # Most repos need NO entry here — egg auto-discovers
  # <repo>/.egg/repositories.yaml from the checkout. Add a block only
  # to override a per-repo default or to set operator-scoped per-repo
  # policies that aren't allowed in the checked-in repo file:
  #
  #   restrict_to_configured_users  (operator policy, repo-file forbidden)
  #   disable_auto_fix              (operator policy, repo-file forbidden)
  #
  # Example: lock auto-fix off for a specific repo and persist an
  # extra system dir from your machine.
  #
  # YOUR_USERNAME/egg:
  #   restrict_to_configured_users: true
  #   disable_auto_fix: true
  #   checkpoint_repo: YOUR_USERNAME/egg-checkpoints
  #   # The repo's own .egg/repositories.yaml already defines
  #   # build_commands / persist / checks — leaving them out here
  #   # means egg uses the checked-in defaults.
  #
  # YOUR_USERNAME/external-bazel-repo:
  #   auth_mode: user        # personal identity for this repo
  #   # If the repo has no .egg/repositories.yaml of its own you can
  #   # supply the per-repo block here as a fallback. Persist lists
  #   # use the unified single-list shape (entries with leading `/`
  #   # are absolute system paths; others are repo-relative).
  #   build_commands:
  #     commands:
  #       - bazel build //...
  #   watch_files:
  #     - WORKSPACE
  #     - BUILD
  #   persist:
  #     - bazel-bin
  #     - /opt/bazel
  #   checks:
  #     - name: test
  #       command: bazel test //...

# ---------------------------------------------------------------------
# User-mode authentication (optional)
# ---------------------------------------------------------------------

# When `auth_mode: user` is set for a repo (here or in its checked-in
# repo file), operations are attributed to this personal GitHub
# account instead of the egg bot. Useful for contributing to external
# repos where bot accounts may not be appropriate.
#
# To use user mode:
#   1. Set GITHUB_USER_TOKEN in secrets.env (a PAT for your personal
#      account).
#   2. Configure user_mode below with your GitHub username.
#   3. Set auth_mode: user for repos that should use it.
#   4. Configure your LOCAL git with your name/email:
#        git config user.name "Your Name"
#        git config user.email "your@email.com"
#
# Permissions in user mode:
#   - CAN push to new branches (that don't exist upstream yet)
#   - CAN push to branches with an open PR owned by egg or the user
#     mode user
#   - CANNOT push to main/master (protected branches)
#   - CANNOT create PRs (you create PRs manually via the GitHub UI).
#
# This ensures the human maintains control over what PRs are opened
# in their name.
user_mode:
  # GitHub username for attribution (must match the PAT owner)
  # github_user: your-username
  # Git author info (informational — configure locally with `git config`)
  # git_name: "Your Name"
  # git_email: "your-email@example.com"

# ---------------------------------------------------------------------
# Local repository configuration
# ---------------------------------------------------------------------

# Local directories on your machine that will be:
#   1. Volume-mounted into the egg container.
#   2. Set up with git worktrees for isolated development.
# Each repo gets its own worktree so the agent can work without
# affecting your working directory. Changes are committed to the
# worktree branch, then you review and merge.
local_repos:
  paths: []
  # Examples:
  #   - /home/username/projects/my-app
  #   - /home/username/work/another-repo

# ---------------------------------------------------------------------
# Docker container setup
# ---------------------------------------------------------------------

# Controls what gets installed when running docker-setup.py.
docker_setup:
  # Extra packages to install beyond core utilities.
  # Core utilities (always installed): git, curl, wget, jq, unzip, vim,
  #   htop, tree, lsof, build-essential / gcc + make.
  extra_packages:
    apt: []   # Ubuntu/Debian packages
    dnf: []   # Fedora/RHEL packages
    packages: []  # Common packages that work on both
  # Examples:
  #   apt:
  #     - nodejs
  #     - python3.11
  #     - postgresql-14
  #   dnf:
  #     - nodejs
  #     - python3.11
  #     - java-11-openjdk
