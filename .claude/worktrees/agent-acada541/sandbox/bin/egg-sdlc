#!/usr/bin/env python3
"""Interactive SDLC pipeline CLI with DAG visualization and HITL checkpoints.

Usage:
    egg-sdlc -r <repo> -i <issue>   # Repo dir + issue number
    egg-sdlc -r <repo> <issue>      # Short form (positional issue)
    egg-sdlc                         # Prompt-driven pipeline (no GitHub)

Examples:
    egg-sdlc -r egg -i 635          # Pipeline for issue #635 in ~/repos/egg
    egg-sdlc -r egg 635             # Same, positional issue number
    egg-sdlc --private -r egg -i 635 # Private repo access
    egg-sdlc                        # Local mode (no GitHub issue)
"""

import os
import sys

# Ensure sandbox packages are importable
_sandbox_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _sandbox_dir not in sys.path:
    sys.path.insert(0, _sandbox_dir)

from egg_lib.sdlc_cli import main

if __name__ == "__main__":
    main()
