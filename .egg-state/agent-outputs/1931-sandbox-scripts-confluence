                fi
                shift || true
                ;;
            --cursor)
                shift
                cursor="${1:-}"
                shift || true
                ;;
            *)
                shift
                ;;
        esac
    done

    local payload
    payload=$(python3 -c "
import json, sys
body = {}
limit, cursor = sys.argv[1], sys.argv[2]
if limit:
    body['limit'] = int(limit)
if cursor:
    body['cursor'] = cursor
print(json.dumps(body))
" "$limit" "$cursor")

    call_gateway "/api/v1/confluence/space/list" "$payload"
