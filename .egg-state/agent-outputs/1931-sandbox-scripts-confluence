                shift || true
                ;;
            *)
                shift
                ;;
        esac
    done

    local payload
    payload=$(python3 -c "
import json, sys
body = {'spaceKey': sys.argv[1]}
limit, cursor, body_format = sys.argv[2], sys.argv[3], sys.argv[4]
if limit:
