    fi
    local space_key="$1"
    shift

    local limit="" cursor="" body_format=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit)
                shift
                limit="${1:-}"
                if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --limit must be an integer, got: $limit" >&2
