    shift
    local limit="" cursor=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit)
                shift
                limit="${1:-}"
                if ! [[ "$limit" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --limit must be an integer, got: $limit" >&2
