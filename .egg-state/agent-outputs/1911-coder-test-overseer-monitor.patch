diff --git a/orchestrator/tests/test_overseer_monitor.py b/orchestrator/tests/test_overseer_monitor.py
index f288b51d5..c11ad3071 100644
--- a/orchestrator/tests/test_overseer_monitor.py
+++ b/orchestrator/tests/test_overseer_monitor.py
@@ -660,6 +660,110 @@ class TestPostConsensusStall:
         monitor._create_hitl_decision.assert_not_awaited()
         monitor._send_slack_notification.assert_not_awaited()
 
+    def test_short_circuits_when_phase_advanced_past_implement(self) -> None:
+        """#1911: when current_phase has moved past 'implement', the
+        detector must stay silent — the transition is clearly
+        underway/complete, not stalled."""
+        monitor = OverseerMonitor(
+            pipeline_id="test-postconsensus-1911-phase",
+            config=_MockConfig(),
+        )
+        monitor._create_hitl_decision = AsyncMock()
+        monitor._send_slack_notification = AsyncMock()
+        monitor._broadcast_alert = AsyncMock()
+
+        consensus = {"is_complete": True}
+        pipeline_data = {"current_phase": "pr"}
+
+        # Backdate first_seen so the grace period is already elapsed —
+        # without the short-circuit this would escalate.
+        monitor._post_consensus_stall_first_seen = time.time() - 999
+
+        _run(monitor._check_post_consensus_stall(consensus, "running", pipeline_data))
+
+        monitor._create_hitl_decision.assert_not_awaited()
+        monitor._send_slack_notification.assert_not_awaited()
+        monitor._broadcast_alert.assert_not_awaited()
+        # Detector re-armable for a future genuine stall
+        assert monitor._post_consensus_stall_first_seen is None
+
+    def test_short_circuits_when_pr_number_populated(self) -> None:
+        """#1911: once ``pipeline.pr_number`` is set, the PR creation has
+        succeeded and the implement→pr handoff is effectively done."""
+        monitor = OverseerMonitor(
+            pipeline_id="test-postconsensus-1911-prnum",
+            config=_MockConfig(),
+        )
+        monitor._create_hitl_decision = AsyncMock()
+        monitor._send_slack_notification = AsyncMock()
+        monitor._broadcast_alert = AsyncMock()
+
+        consensus = {"is_complete": True}
+        # current_phase still "implement" but pr_number is now set
+        pipeline_data = {"current_phase": "implement", "pr_number": 99}
+
+        monitor._post_consensus_stall_first_seen = time.time() - 999
+
+        _run(monitor._check_post_consensus_stall(consensus, "running", pipeline_data))
+
+        monitor._create_hitl_decision.assert_not_awaited()
+        monitor._send_slack_notification.assert_not_awaited()
+        monitor._broadcast_alert.assert_not_awaited()
+        assert monitor._post_consensus_stall_first_seen is None
+
+    def test_short_circuits_when_pr_url_artifact_present(self) -> None:
+        """#1911: a populated ``phases['pr'].artifacts['pr_url']`` is
+        the strongest signal that transition completed — detector must
+        stay silent."""
+        monitor = OverseerMonitor(
+            pipeline_id="test-postconsensus-1911-prurl",
+            config=_MockConfig(),
+        )
+        monitor._create_hitl_decision = AsyncMock()
+        monitor._send_slack_notification = AsyncMock()
+        monitor._broadcast_alert = AsyncMock()
+
+        consensus = {"is_complete": True}
+        pipeline_data = {
+            "current_phase": "implement",
+            "phases": {"pr": {"artifacts": {"pr_url": "https://github.com/owner/repo/pull/99"}}},
+        }
+
+        monitor._post_consensus_stall_first_seen = time.time() - 999
+
+        _run(monitor._check_post_consensus_stall(consensus, "running", pipeline_data))
+
+        monitor._create_hitl_decision.assert_not_awaited()
+        monitor._send_slack_notification.assert_not_awaited()
+        monitor._broadcast_alert.assert_not_awaited()
+        assert monitor._post_consensus_stall_first_seen is None
+
+    def test_short_circuit_does_not_suppress_genuine_stall(self) -> None:
+        """#1911: short-circuit is strictly additive — when none of the
+        transition-completion indicators are present, the detector
+        still escalates after the grace period."""
+        monitor = OverseerMonitor(
+            pipeline_id="test-postconsensus-1911-genuine",
+            config=_MockConfig(),
+        )
+        monitor._create_hitl_decision = AsyncMock()
+        monitor._send_slack_notification = AsyncMock()
+        monitor._broadcast_alert = AsyncMock()
+
+        consensus = {"is_complete": True}
+        pipeline_data = {
+            "current_phase": "implement",
+            "phases": {"pr": {"artifacts": {}}},
+            # pr_number deliberately absent
+        }
+        monitor._post_consensus_stall_first_seen = time.time() - 999
+
+        _run(monitor._check_post_consensus_stall(consensus, "running", pipeline_data))
+
+        monitor._create_hitl_decision.assert_awaited_once()
+        monitor._send_slack_notification.assert_awaited_once()
+        monitor._broadcast_alert.assert_awaited_once()
+
 
