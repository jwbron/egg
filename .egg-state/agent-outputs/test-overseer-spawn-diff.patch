+# ---------------------------------------------------------------------------
+# Scenario 11: Respawn gating via phase_overseer_active flag
+# ---------------------------------------------------------------------------
+
+
+class TestRespawnGating:
+    """Verify _check_and_respawn_overseer is gated by phase_overseer_active flag."""
+
+    def test_respawn_skipped_when_phase_overseer_inactive(self, mock_docker_client):
+        """When phase_overseer_active is False, respawn should not be attempted.
+
+        The health monitor poll thread checks phase_overseer_active before
+        calling _check_and_respawn_overseer.  This test verifies that pattern
+        works correctly — when the flag is False, the respawn function should
+        not be called even if the container has exited.
+        """
+        mock_spawner = MagicMock()
+        mock_spawner.docker = mock_docker_client
+
+        mock_docker_client.get_container_info.return_value = ContainerInfo(
+            container_id="overseer-between-phases",
+            container_name="egg-issue-gate-overseer",
+            status=ContainerStatus.EXITED,
+            exit_code=0,
+        )
+
+        # Simulate the gating logic from _health_monitor_poll:
+        # when phase_overseer_active is False, _check_and_respawn_overseer
+        # is never called.
+        phase_overseer_active = False
+        respawn_called = False
+
+        if phase_overseer_active:
+            _check_and_respawn_overseer(
+                spawner=mock_spawner,
+                store=MagicMock(),
+                pipeline_id="issue-gate",
+                pipeline=Pipeline(id="issue-gate", status=PipelineStatus.RUNNING),
+                overseer_container_id="overseer-between-phases",
+                overseer_respawn_count=0,
+                max_overseer_respawns=3,
+                gateway_mode="public",
+                pipeline_repos=None,
+                certs_volume=None,
+            )
+            respawn_called = True
+
+        assert not respawn_called, (
+            "Respawn should be skipped when phase_overseer_active is False"
+        )
+        mock_spawner.spawn_overseer_container.assert_not_called()
+
+    def test_respawn_allowed_when_phase_overseer_active(self, mock_docker_client):
+        """When phase_overseer_active is True, respawn proceeds normally."""
+        mock_spawner = MagicMock()
+        mock_spawner.docker = mock_docker_client
+
+        mock_docker_client.get_container_info.return_value = ContainerInfo(
+            container_id="overseer-mid-phase",
+            container_name="egg-issue-gate-overseer",
+            status=ContainerStatus.EXITED,
+            exit_code=0,
+        )
+
+        mock_store = MagicMock()
+        mock_store.load_pipeline.return_value = Pipeline(
+            id="issue-gate",
+            status=PipelineStatus.RUNNING,
+        )
+
+        mock_spawner.spawn_overseer_container.return_value = SpawnedContainer(
+            container_info=ContainerInfo(
+                container_id="overseer-respawned",
+                container_name="egg-issue-gate-overseer",
+                status=ContainerStatus.RUNNING,
+            ),
+            session_info=None,
+            agent_role=AgentRole.OVERSEER,
+            pipeline_id="issue-gate",
+            environment={},
+        )
+
+        phase_overseer_active = True
+        new_id = None
+
+        if phase_overseer_active:
+            new_id, _ = _check_and_respawn_overseer(
+                spawner=mock_spawner,
+                store=mock_store,
+                pipeline_id="issue-gate",
+                pipeline=Pipeline(
+                    id="issue-gate",
+                    status=PipelineStatus.RUNNING,
+                    config=PipelineConfig(overseer_max_respawns=3),
+                ),
+                overseer_container_id="overseer-mid-phase",
+                overseer_respawn_count=0,
+                max_overseer_respawns=3,
+                gateway_mode="public",
+                pipeline_repos=None,
+                certs_volume=None,
+            )
+
+        assert new_id == "overseer-respawned", (
+            "Respawn should proceed when phase_overseer_active is True"
+        )
+        mock_spawner.spawn_overseer_container.assert_called_once()
