+# ---------------------------------------------------------------------------
+# New tests for issue #1695 items
+# ---------------------------------------------------------------------------
+
+
+class TestRestartConcurrencyGuard:
+    """Tests for per-(pipeline_id, agent_role) lock serialisation (issue #1695 item 1)."""
+
+    def test_concurrent_restarts_serialised(self, spawner, mock_docker_client, mock_gateway_client):
+        """Two threads calling restart_agent_container simultaneously: only one
+        succeeds past the limit when max_restarts=1."""
+        import threading
+
+        results: list[SpawnedContainer | Exception] = [None, None]  # type: ignore[list-item]
+
+        def do_restart(idx: int) -> None:
+            try:
+                r = spawner.restart_agent_container(
+                    pipeline_id="issue-100",
+                    agent_role=AgentRole.CODER,
+                    issue_number=100,
+                    mode="public",
+                    max_restarts=1,
+                )
+                results[idx] = r
+            except Exception as exc:
+                results[idx] = exc
+
+        t1 = threading.Thread(target=do_restart, args=(0,))
+        t2 = threading.Thread(target=do_restart, args=(1,))
+        t1.start()
+        t2.start()
+        t1.join(timeout=10)
+        t2.join(timeout=10)
+
+        successes = [r for r in results if isinstance(r, SpawnedContainer)]
+        failures = [r for r in results if isinstance(r, ContainerSpawnError)]
+
+        assert len(successes) == 1, f"Expected exactly 1 success, got {len(successes)}"
+        assert len(failures) == 1, f"Expected exactly 1 failure, got {len(failures)}"
+
+
+class TestFailedSpawnIncrementsCount:
+    """Tests that a failed spawn_agent_container still increments restart count (issue #1695 item 4)."""
+
+    def test_failed_spawn_increments_count(self, spawner, mock_docker_client, mock_gateway_client):
+        """A spawn failure should still burn one restart budget slot."""
+        mock_docker_client.create_container.side_effect = ContainerOperationError("no space")
+
+        assert spawner.get_restart_count("issue-100", "coder") == 0
+
+        with pytest.raises(ContainerSpawnError):
+            spawner.restart_agent_container(
+                pipeline_id="issue-100",
+                agent_role=AgentRole.CODER,
+                issue_number=100,
+                mode="public",
+            )
+
+        # Count should be incremented even though spawn failed
+        assert spawner.get_restart_count("issue-100", "coder") == 1
+
