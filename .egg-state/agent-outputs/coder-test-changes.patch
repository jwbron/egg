+# ---------------------------------------------------------------------------
+# Helpers: Infrastructure error progress events
+# ---------------------------------------------------------------------------
+
+
+def _emit_progress_with_state(
+    event_bus: EventBus,
+    state: str,
+    blocker: str = "",
+    agent_id: str = AGENT_ID,
+    pipeline_id: str = PIPELINE_ID,
+) -> Event:
+    """Emit a progress event with state and optional blocker."""
+    data = {"agent_id": agent_id, "type": "progress", "state": state}
+    if blocker:
+        data["blocker"] = blocker
+    return event_bus.emit(
+        EventType.PROGRESS_EMITTED,
+        pipeline_id=pipeline_id,
+        data=data,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Tests: Infrastructure error tripwire
