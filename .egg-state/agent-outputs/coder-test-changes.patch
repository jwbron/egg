+# ---------------------------------------------------------------------------
+# Decision maker: restartable infrastructure error routing (issue #1695 item 6)
+# ---------------------------------------------------------------------------
+
+
+class TestDecisionMakerRestartableInfraErrors:
+    """Tests that infrastructure errors with restartable patterns produce restart_agent,
+    while non-matching infra errors still produce hitl."""
+
+    def test_unresponsive_routes_to_restart_agent(self) -> None:
+        """Infrastructure error with 'unresponsive' in reasoning should auto-restart."""
+        result = _run(
+            decide_corrective_action(
+                classification={
+                    "classification": "infrastructure_error",
+                    "reasoning": "Agent container became unresponsive after OOM kill",
+                },
+                context={"agent_role": "coder", "pipeline_id": "issue-100"},
+            )
+        )
+        assert result["action"] == "restart_agent"
+        assert result["priority"] in ("high", "critical")
+
+    def test_crashed_routes_to_restart_agent(self) -> None:
+        """Infrastructure error with 'crashed' should auto-restart."""
+        result = _run(
+            decide_corrective_action(
+                classification={
+                    "classification": "infrastructure_error",
+                    "reasoning": "Container crashed with exit code 137",
+                },
+                context={},
+            )
+        )
+        assert result["action"] == "restart_agent"
+
+    def test_timeout_routes_to_restart_agent(self) -> None:
