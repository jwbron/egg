+
+class TestInfrastructureErrorTripwire:
+    """Tripwire #6: infrastructure errors in blocked progress events."""
+
+    def test_infra_error_triggers_critical_alert(self):
+        """Blocked progress with infra keyword triggers infrastructure_error alert."""
+        bus = _make_event_bus()
+        monitor = _make_monitor(bus)
+
+        escalations = []
+        monitor.on_escalation(lambda e: escalations.append(e))
+
+        _emit_progress_with_state(bus, "blocked", blocker="git add failed: .gitignore rule")
+
+        actions = monitor._check_infra_errors()
+
+        assert len(actions) == 1
+        assert actions[0]["action"] == "escalate"
+        assert actions[0]["alert_type"] == "infrastructure_error"
+        assert len(escalations) == 1
+        assert escalations[0]["type"] == "hitl"
+
+        alerts = monitor.get_active_alerts()
+        infra_alerts = [a for a in alerts if a["alert_type"] == "infrastructure_error"]
+        assert len(infra_alerts) == 1
+        assert infra_alerts[0]["severity"] == "critical"
+
+    def test_non_infra_blocker_ignored(self):
+        """Blocked progress with non-infra blocker does NOT trigger alert."""
+        bus = _make_event_bus()
+        monitor = _make_monitor(bus)
+
+        escalations = []
+        monitor.on_escalation(lambda e: escalations.append(e))
+
+        _emit_progress_with_state(bus, "blocked", blocker="waiting for reviewer")
+
+        actions = monitor._check_infra_errors()
+
+        assert len(actions) == 0
+        assert len(escalations) == 0
+
+    def test_dedup_prevents_repeat_alert(self):
+        """Second identical infra error does NOT create duplicate alert."""
+        bus = _make_event_bus()
+        monitor = _make_monitor(bus)
+
+        escalations = []
+        monitor.on_escalation(lambda e: escalations.append(e))
+
+        _emit_progress_with_state(bus, "blocked", blocker="permission denied")
+
+        actions1 = monitor._check_infra_errors()
+        actions2 = monitor._check_infra_errors()
+
+        assert len(actions1) == 1
+        assert len(actions2) == 0
+        assert len(escalations) == 1
+
+    def test_flag_resets_on_working_progress(self):
+        """After recovery (working state), a new infra error triggers again."""
+        bus = _make_event_bus()
