+
+class TestBrcRewriteAndDraftCleanupIntegration:
+    """Integration test: exercises _rewrite_brc_history_for_pr and _cleanup_drafts_for_pr
+    end-to-end with simulated git operations (#1633).
+
+    This closes the test gap where mock-based tests only patched the functions
+    themselves, missing git-level failures (e.g. missing `git add`, wrong cwd,
+    or subprocess errors). Here we let the real function logic run, only mocking
+    the subprocess.run calls to simulate git behavior, verifying the full call
+    chain produces the expected git operations (add, diff, commit, rm).
+    """
+
+    def test_full_rewrite_and_cleanup_produces_commits(self, tmp_path: Path, monkeypatch):
+        """End-to-end: _rewrite_brc_history_for_pr writes BRC history files and
+        calls git add/commit; _cleanup_drafts_for_pr calls git rm/commit.
+
+        Asserts:
+        (a) A git commit with message containing "Persist BRC history" was issued
+        (b) A git commit with message containing "Remove pipeline draft" was issued
+        (c) BRC history files exist on disk (written by _write_brc_history)
+        (d) Draft files are removed from disk (via git rm fallback to unlink)
+        """
+        import routes.pipelines as mod
+        from routes.pipelines import _cleanup_drafts_for_pr, _rewrite_brc_history_for_pr
+
+        repo = tmp_path / "repo"
+        repo.mkdir()
+
+        # Set up tracked draft files
+        drafts_dir = repo / ".egg-state" / "drafts"
+        drafts_dir.mkdir(parents=True)
+        (drafts_dir / "42-analysis.md").write_text("Draft analysis content")
+        (drafts_dir / "42-plan.md").write_text("Draft plan content")
+
+        # Prepare BRC messages for the mock store
+        messages = [
+            _make_brc_message(
+                pipeline_id="issue-42",
+                from_role="coder",
+                message_type=MessageType.CONSENSUS_PROPOSE,
+                subject="Implement proposal",
+                body="Proposed implementation changes",
+                phase="implement",
+            ),
+            _make_brc_message(
+                pipeline_id="issue-42",
+                from_role="reviewer_code",
+                message_type=MessageType.CONSENSUS_ACK,
+                subject="ACK from reviewer",
+                body="LGTM",
+                phase="implement",
+            ),
+            _make_brc_message(
+                pipeline_id="issue-42",
+                from_role="coder",
+                message_type=MessageType.CONSENSUS_CONFIRMED,
+                subject="Confirmed",
+                body="",
+                phase="implement",
+            ),
+        ]
+
+        mock_store = MagicMock(spec=MessageStore)
+        mock_store.get_messages.return_value = messages
+
+        # Build pipeline_phases dict with one COMPLETE phase
+        phases = {
+            "implement": MagicMock(status=PipelineStatus.COMPLETE),
+        }
+
+        # Track all subprocess calls for assertion
+        git_calls: list[list[str]] = []
+
+        def fake_subprocess_run(cmd, **kwargs):
+            git_calls.append(cmd)
+            result = MagicMock()
+            result.stdout = ""
+            result.stderr = ""
+            # For "git diff --cached --quiet" — return 1 to indicate staged changes
+            if "diff" in cmd and "--cached" in cmd:
+                result.returncode = 1
+            else:
+                result.returncode = 0
+            if kwargs.get("check") and result.returncode != 0:
+                # Only raise for check=True commands that aren't expected to fail
+                if "diff" not in cmd:
+                    raise subprocess.CalledProcessError(
+                        result.returncode, cmd, result.stdout, result.stderr
+                    )
+            return result
+
+        monkeypatch.setattr(mod.subprocess, "run", fake_subprocess_run)
+
+        # Execute _rewrite_brc_history_for_pr (writes BRC history files + git add/commit)
+        with patch("message_store.get_message_store", return_value=mock_store):
+            _rewrite_brc_history_for_pr(repo, "issue-42", phases, 42)
+
+        # Execute _cleanup_drafts_for_pr (git rm + commit)
+        cleanup_result = _cleanup_drafts_for_pr(repo, 42)
+
+        # --- Assertions ---
+
+        # (a) A git commit with "Persist BRC history" was issued
+        commit_messages = [
+            cmd[cmd.index("-m") + 1]
+            for cmd in git_calls
+            if "commit" in cmd and "-m" in cmd
+        ]
+        assert any(
+            "Persist BRC history" in msg for msg in commit_messages
+        ), f"Expected commit with 'Persist BRC history', got: {commit_messages}"
+
+        # (b) A git commit with "Remove pipeline draft" was issued
+        assert any(
+            "Remove pipeline draft" in msg for msg in commit_messages
+        ), f"Expected commit with 'Remove pipeline draft', got: {commit_messages}"
+
+        # (c) BRC history files exist on disk (written by _write_brc_history)
+        history_dir = repo / ".egg-state" / "brc-history"
+        assert history_dir.exists(), "BRC history directory should exist"
+        brc_files = list(history_dir.iterdir())
+        assert len(brc_files) > 0, "Expected BRC history files to be written"
+        assert (
+            history_dir / "42-implement.md"
+        ).exists(), "Expected 42-implement.md in brc-history"
+        # Verify content is meaningful
+        content = (history_dir / "42-implement.md").read_text()
+        assert "BRC Consensus History" in content
+        assert "CONSENSUS_PROPOSE" in content
+        assert "CONSENSUS_ACK" in content
+
+        # (d) Draft files are removed (git rm succeeded → commit made)
+        # _cleanup_drafts_for_pr returned True because our mock returned 0 for
+        # the git rm calls, setting removed=True, then commit succeeded
+        assert cleanup_result is True
+
+        # Verify git add was called with paths containing brc-history
+        add_calls = [cmd for cmd in git_calls if "add" in cmd and "--force" in cmd]
+        assert len(add_calls) > 0, "Expected git add --force calls for BRC history files"
+        # At least one add call should reference brc-history files
+        add_paths = [arg for cmd in add_calls for arg in cmd if "brc-history" in arg]
+        assert len(add_paths) > 0, f"Expected brc-history in git add args, got: {add_calls}"
+
+        # Verify git rm was called for draft files
+        rm_calls = [cmd for cmd in git_calls if "rm" in cmd]
+        assert len(rm_calls) == 2, f"Expected 2 git rm calls (one per draft), got {len(rm_calls)}"
