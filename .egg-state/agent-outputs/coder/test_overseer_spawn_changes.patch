+# ---------------------------------------------------------------------------
+# Scenario 13: Respawn broadcasts OVERSEER_ALERT (issue #1562)
+# ---------------------------------------------------------------------------
+
+
+class TestRespawnBroadcastAlert:
+    """Verify _check_and_respawn_overseer broadcasts OVERSEER_ALERT on respawn."""
+
+    @pytest.fixture
+    def mock_spawner_for_broadcast(self, mock_docker_client):
+        """Mock spawner that returns a new container on respawn."""
+        mock = MagicMock()
+        mock.docker = mock_docker_client
+        respawned_id = "overseer-broadcast-new"
+        mock.spawn_overseer_container.return_value = SpawnedContainer(
+            container_info=ContainerInfo(
+                container_id=respawned_id,
+                container_name="egg-issue-1562-overseer",
+                status=ContainerStatus.RUNNING,
+                started_at=datetime.now(UTC),
+            ),
+            session_info=None,
+            agent_role=AgentRole.OVERSEER,
+            pipeline_id="issue-1562",
+            environment={},
+        )
+        return mock
+
+    @pytest.fixture
+    def mock_store_running(self):
+        """Mock state store returning a RUNNING pipeline."""
+        store = MagicMock()
+        store.load_pipeline.return_value = Pipeline(
+            id="issue-1562",
+            issue_number=1562,
+            status=PipelineStatus.RUNNING,
+        )
+        return store
+
+    @pytest.fixture
+    def running_pipeline_1562(self):
+        """Pipeline in RUNNING state for broadcast tests."""
+        return Pipeline(
+            id="issue-1562",
+            issue_number=1562,
+            status=PipelineStatus.RUNNING,
+            config=PipelineConfig(overseer_max_respawns=3),
+        )
+
+    def test_broadcast_alert_on_successful_respawn(
+        self, mock_spawner_for_broadcast, mock_docker_client, mock_store_running,
+        running_pipeline_1562, monkeypatch,
+    ):
+        """After successful respawn, an OVERSEER_ALERT message is broadcast."""
+        original_id = "overseer-broadcast-old"
+        mock_docker_client.get_container_info.return_value = ContainerInfo(
+            container_id=original_id,
+            container_name="egg-issue-1562-overseer",
+            status=ContainerStatus.EXITED,
+            exit_code=137,
+        )
+        mock_docker_client.get_container_logs.return_value = "some log output\nlast line"
+
+        # Mock _get_message_store to return a mock message store
+        mock_msg_store = MagicMock()
+        mock_get_store = MagicMock(return_value=mock_msg_store)
+
+        monkeypatch.setattr(
+            "routes.pipelines._get_message_store",
+            lambda: mock_get_store,
+        )
+
+        new_id, new_count = _check_and_respawn_overseer(
+            spawner=mock_spawner_for_broadcast,
+            store=mock_store_running,
+            pipeline_id="issue-1562",
+            pipeline=running_pipeline_1562,
+            overseer_container_id=original_id,
+            overseer_respawn_count=0,
+            max_overseer_respawns=3,
+            gateway_mode="public",
+            pipeline_repos=None,
+            certs_volume=None,
+        )
+
+        assert new_id == "overseer-broadcast-new"
+        assert new_count == 1
+
+        # Verify add_message was called
+        mock_msg_store.add_message.assert_called_once()
+        msg = mock_msg_store.add_message.call_args[0][0]
+        assert msg.message_type == "OVERSEER_ALERT"
+        assert "overseer_restart" in msg.subject
+        assert msg.metadata["exit_code"] == 137
+        assert msg.metadata["old_container_id"] == original_id
+        assert msg.metadata["new_container_id"] == "overseer-broadcast-new"
+        assert msg.metadata["log_tail"] == "some log output\nlast line"
+        assert msg.metadata["respawn_attempt"] == 1
+        assert msg.metadata["max_respawns"] == 3
+        assert msg.phase == "refine"  # default current_phase
+
+    def test_broadcast_skipped_when_message_store_unavailable(
+        self, mock_spawner_for_broadcast, mock_docker_client, mock_store_running,
+        running_pipeline_1562, monkeypatch,
+    ):
+        """Broadcast is skipped gracefully when _get_message_store() returns None."""
+        original_id = "overseer-nostore-old"
+        mock_docker_client.get_container_info.return_value = ContainerInfo(
+            container_id=original_id,
+            container_name="egg-issue-1562-overseer",
+            status=ContainerStatus.EXITED,
+            exit_code=0,
+        )
+        mock_docker_client.get_container_logs.return_value = "logs"
+
+        # _get_message_store returns None
+        monkeypatch.setattr(
+            "routes.pipelines._get_message_store",
+            lambda: None,
+        )
+
+        new_id, new_count = _check_and_respawn_overseer(
+            spawner=mock_spawner_for_broadcast,
+            store=mock_store_running,
+            pipeline_id="issue-1562",
+            pipeline=running_pipeline_1562,
+            overseer_container_id=original_id,
+            overseer_respawn_count=0,
+            max_overseer_respawns=3,
+            gateway_mode="public",
+            pipeline_repos=None,
+            certs_volume=None,
+        )
+
+        # Respawn still succeeded even though broadcast was skipped
+        assert new_id == "overseer-broadcast-new"
+        assert new_count == 1
+
+    def test_log_tail_capture_graceful_on_error(
+        self, mock_spawner_for_broadcast, mock_docker_client, mock_store_running,
+        running_pipeline_1562, monkeypatch,
+    ):
+        """Log tail capture is skipped gracefully when get_container_logs raises."""
+        original_id = "overseer-logfail-old"
+        mock_docker_client.get_container_info.return_value = ContainerInfo(
+            container_id=original_id,
+            container_name="egg-issue-1562-overseer",
+            status=ContainerStatus.EXITED,
+            exit_code=1,
+        )
+        mock_docker_client.get_container_logs.side_effect = ContainerNotFoundError(
+            "Container not found"
+        )
+
+        mock_msg_store = MagicMock()
+        mock_get_store = MagicMock(return_value=mock_msg_store)
+        monkeypatch.setattr(
+            "routes.pipelines._get_message_store",
+            lambda: mock_get_store,
+        )
+
+        new_id, new_count = _check_and_respawn_overseer(
+            spawner=mock_spawner_for_broadcast,
+            store=mock_store_running,
+            pipeline_id="issue-1562",
+            pipeline=running_pipeline_1562,
+            overseer_container_id=original_id,
+            overseer_respawn_count=0,
+            max_overseer_respawns=3,
+            gateway_mode="public",
+            pipeline_repos=None,
+            certs_volume=None,
+        )
+
+        # Respawn succeeded despite log capture failure
+        assert new_id == "overseer-broadcast-new"
+        assert new_count == 1
+
+        # Log tail should be "unavailable" in the metadata
+        msg = mock_msg_store.add_message.call_args[0][0]
+        assert msg.metadata["log_tail"] == "unavailable"
+
+    def test_broadcast_failure_does_not_block_respawn(
+        self, mock_spawner_for_broadcast, mock_docker_client, mock_store_running,
+        running_pipeline_1562, monkeypatch,
+    ):
+        """Broadcast failure does not prevent respawn from returning success."""
+        original_id = "overseer-bcastfail-old"
+        mock_docker_client.get_container_info.return_value = ContainerInfo(
+            container_id=original_id,
+            container_name="egg-issue-1562-overseer",
+            status=ContainerStatus.EXITED,
+            exit_code=0,
+        )
+        mock_docker_client.get_container_logs.return_value = "logs"
+
+        # _get_message_store raises an exception
+        def exploding_store():
+            raise RuntimeError("Message store exploded")
+
+        monkeypatch.setattr(
+            "routes.pipelines._get_message_store",
+            exploding_store,
+        )
+
+        new_id, new_count = _check_and_respawn_overseer(
+            spawner=mock_spawner_for_broadcast,
+            store=mock_store_running,
+            pipeline_id="issue-1562",
+            pipeline=running_pipeline_1562,
+            overseer_container_id=original_id,
+            overseer_respawn_count=0,
+            max_overseer_respawns=3,
+            gateway_mode="public",
+            pipeline_repos=None,
+            certs_volume=None,
+        )
+
+        # Respawn still succeeded
+        assert new_id == "overseer-broadcast-new"
+        assert new_count == 1
