+# ---------------------------------------------------------------------------
+# Scenario 12: spawn_overseer_container passes max_turns (issue #1562)
+# ---------------------------------------------------------------------------
+
+
+class TestSpawnOverseerMaxTurns:
+    """Verify spawn_overseer_container passes max_turns to build_agent_command."""
+
+    def test_default_max_turns_in_command(self, spawner, mock_docker_client):
+        """Default max_turns=2000 appears in the agent command."""
+        spawner.spawn_overseer_container(
+            pipeline_id="issue-1562-turns",
+            issue_number=1562,
+        )
+
+        create_call = mock_docker_client.create_container.call_args
+        command = create_call.kwargs.get("command", [])
+        turns_idx = command.index("--max-turns")
+        assert command[turns_idx + 1] == "2000", (
+            f"Expected --max-turns 2000, got --max-turns {command[turns_idx + 1]}"
+        )
+
+    def test_custom_max_turns_in_command(self, spawner, mock_docker_client):
+        """Custom max_turns value is passed through to the agent command."""
+        spawner.spawn_overseer_container(
+            pipeline_id="issue-1562-custom",
+            issue_number=1562,
+            max_turns=3500,
+        )
+
+        create_call = mock_docker_client.create_container.call_args
+        command = create_call.kwargs.get("command", [])
+        turns_idx = command.index("--max-turns")
+        assert command[turns_idx + 1] == "3500", (
+            f"Expected --max-turns 3500, got --max-turns {command[turns_idx + 1]}"
+        )
+
