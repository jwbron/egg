+        session = _make_session(synthetic=True, assigned_branch="egg/issue-2548/context")
+        patches = _push_context(session)
+        with (
+            patches[0],
+            patches[1],
+            patches[2],
+            patches[3],
+            patches[4],
+            patches[5],
+            patches[6],
+        ):
+            with patch.object(gateway, "audit_log") as mock_audit:
+                response = _do_push(
+                    client,
+                    refspec="main:refs/heads/egg/issue-2548/context",
