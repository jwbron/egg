+        constraint as the slice integration branch regex."""
+        session = _make_session(synthetic=True, assigned_branch="egg/foo/bar/context")
+        patches = _push_context(session)
+        with (
+            patches[0],
+            patches[1],
+            patches[2],
+            patches[3],
+            patches[4],
+            patches[5],
+            patches[6],
+        ):
+            response = _do_push(
+                client,
+                refspec="main:refs/heads/egg/foo/bar/context",
