  "pr": {
    "title": "Wait for all reviewers before addressing feedback",
    "description": "The address-feedback bot currently triggers on each reviewer's feedback,\ncausing race conditions. This change adds a wait step that polls for all\n`egg-reviewer-*` checks to complete before running.\n\nFixes #382"
  }
