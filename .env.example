# egg Docker Compose environment configuration
# Copy this file to .env and configure before running docker compose up

# =============================================================================
# Required Configuration
# =============================================================================

# Launcher secret for gateway API authentication
# Generate with: openssl rand -hex 32
EGG_LAUNCHER_SECRET=

# GitHub personal access token (for git operations)
# Required scopes: repo, read:org (if accessing org repos)
GITHUB_USER_TOKEN=

# =============================================================================
# Directory Paths
# =============================================================================

# Configuration directory containing repositories.yaml and secrets
# Default: current directory
EGG_CONFIG_DIR=.

# Repositories directory (will be mounted into containers)
# Default: ./repos
EGG_REPOS_DIR=./repos

# Host home directory (used for path translation)
# Default: /home/egg
HOST_HOME=/home/egg

# =============================================================================
# Container Identity
# =============================================================================

# Host UID/GID for file ownership (should match your user)
# Find with: id -u && id -g
HOST_UID=1000
HOST_GID=1000

# Git identity for commits
EGG_USER_GIT_NAME=egg
EGG_USER_GIT_EMAIL=egg@localhost

# =============================================================================
# Network Ports
# =============================================================================

# Gateway API port (for git/gh operations from sandbox)
GATEWAY_API_PORT=9848

# Squid proxy port (for filtered internet access)
GATEWAY_PROXY_PORT=3129

# =============================================================================
# Optional: Bot Mode (for GitHub App authentication)
# =============================================================================

# Bot GitHub token (if using GitHub App instead of PAT)
# BOT_GITHUB_TOKEN=

# Bot identity for policy enforcement
# GATEWAY_BOT_NAME=james-in-a-box
# GATEWAY_BOT_BRANCH_PREFIX=james-in-a-box/
# GATEWAY_TRUSTED_USERS=

# =============================================================================
# Docker Configuration
# =============================================================================

# Compose project name (prefixes container/network names)
COMPOSE_PROJECT_NAME=egg

# Image names (for pre-built images from GHCR)
# EGG_GATEWAY_IMAGE=ghcr.io/jwbron/egg-gateway:latest
# EGG_SANDBOX_IMAGE=ghcr.io/jwbron/egg-sandbox:latest
