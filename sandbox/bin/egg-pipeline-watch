#!/usr/bin/env python3
"""
Watch pipeline progress via polling.

Polls the orchestrator's visualization endpoint and renders the
DAG view in the terminal, refreshing on each poll.

Usage:
    egg-pipeline-watch <pipeline_id> [--interval SECONDS] [--once] [--compact]

Options:
    --interval  Polling interval in seconds (default: 10)
    --once      Show current state and exit (no polling)
    --compact   Show compact one-line status instead of DAG
"""

import argparse
import json
import os
import re
import signal
import socket
import sys
import time
from http.client import HTTPConnection
from urllib.parse import urlparse

# ANSI escape codes
RESET = "\033[0m"
DIM = "\033[2m"
BOLD = "\033[1m"
GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
CYAN = "\033[36m"

# Whether stdout is a real terminal (vs piped/captured by Claude Code)
IS_TTY = sys.stdout.isatty()

# Regex to strip ANSI escape sequences
_ANSI_RE = re.compile(r"\033\[[0-9;?]*[A-Za-z]")

# Terminal statuses that mean the pipeline is done
TERMINAL_STATUSES = {"complete", "failed", "cancelled"}

# Default polling interval
DEFAULT_INTERVAL = 10

# Number of consecutive fetch errors before giving up
MAX_CONSECUTIVE_ERRORS = 3


def _is_inside_container() -> bool:
    """Detect whether we're running inside a Docker container."""
    try:
        socket.getaddrinfo("egg-orchestrator", None)
        return True
    except socket.gaierror:
        return False


def get_orchestrator_url() -> str:
    """Get the orchestrator base URL from environment or auto-detect.

    Priority:
    1. EGG_ORCHESTRATOR_URL env var (explicit override)
    2. http://egg-orchestrator:9849 (inside container, hostname resolves)
    3. http://localhost:9849 (host machine, port mapped via docker-compose)
    """
    env_url = os.environ.get("EGG_ORCHESTRATOR_URL")
    if env_url:
        return env_url

    if _is_inside_container():
        return "http://egg-orchestrator:9849"

    return "http://localhost:9849"


def strip_ansi(text: str) -> str:
    """Remove ANSI escape sequences from text."""
    return _ANSI_RE.sub("", text)


def _write(text: str, file=None) -> None:
    """Write text, stripping ANSI codes if not a TTY."""
    file = file or sys.stdout
    if not file.isatty():
        text = strip_ansi(text)
    file.write(text)
    file.flush()


def _clear_screen() -> None:
    """Clear the terminal screen and move cursor to top."""
    if IS_TTY:
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()


def _http_get(host: str, port: int, path: str) -> tuple[int, str] | None:
    """Make an HTTP GET request. Returns (status_code, body) or None on error."""
    try:
        conn = HTTPConnection(host, port, timeout=10)
        conn.request("GET", path)
        response = conn.getresponse()
        body = response.read().decode("utf-8", errors="replace")
        conn.close()
        return response.status, body
    except ConnectionRefusedError:
        _write(
            f"{RED}Cannot connect to orchestrator at {host}:{port}\n"
            f"Is the orchestrator running?{RESET}\n",
            file=sys.stderr,
        )
        return None
    except Exception as e:
        _write(f"{RED}Connection error: {e}{RESET}\n", file=sys.stderr)
        return None


def fetch_status(host: str, port: int, pipeline_id: str) -> dict | None:
    """Fetch pipeline status from the orchestrator."""
    path = f"/api/v1/pipelines/{pipeline_id}/status"
    result = _http_get(host, port, path)
    if result is None:
        return None

    status_code, body = result
    if status_code != 200:
        try:
            err = json.loads(body)
            msg = err.get("message", body)
        except json.JSONDecodeError:
            msg = body
        _write(f"{RED}Error ({status_code}): {msg}{RESET}\n", file=sys.stderr)
        return None

    try:
        return json.loads(body)
    except json.JSONDecodeError:
        _write(f"{RED}Invalid JSON in response{RESET}\n", file=sys.stderr)
        return None


def fetch_visualization(host: str, port: int, pipeline_id: str) -> str | None:
    """Fetch pipeline DAG visualization as plain text."""
    path = f"/api/v1/pipelines/{pipeline_id}/visualization?format=text"
    result = _http_get(host, port, path)
    if result is None:
        return None

    status_code, body = result
    if status_code != 200:
        return None

    return body


def format_status_line(pipeline_id: str, data: dict) -> str:
    """Format a single-line status display."""
    status = data.get("status", "unknown")
    phase = data.get("current_phase", "unknown")
    pending = data.get("pending_decisions", 0)
    updated = data.get("updated_at", "")

    status_colors = {
        "running": CYAN,
        "complete": GREEN,
        "failed": RED,
        "pending": DIM,
        "awaiting_human": YELLOW,
        "cancelled": RED,
    }
    color = status_colors.get(status, "")

    time_part = ""
    if updated:
        time_part = updated.split("T")[-1].rstrip("Z")[:8]

    line = f"{BOLD}{pipeline_id}{RESET}  {color}{status}{RESET}  phase={phase}"
    if pending:
        line += f"  {YELLOW}({pending} pending decision{'s' if pending != 1 else ''}){RESET}"
    if time_part:
        line += f"  {DIM}{time_part}{RESET}"

    return line


def watch_pipeline(
    pipeline_id: str,
    interval: int = DEFAULT_INTERVAL,
    once: bool = False,
    compact: bool = False,
) -> int:
    """Poll pipeline status and display updates.

    Args:
        pipeline_id: Pipeline to watch
        interval: Polling interval in seconds
        once: Show current state and exit
        compact: Show compact one-line status instead of DAG

    Returns:
        Exit code (0 = success, 1 = error)
    """
    base_url = get_orchestrator_url()
    parsed = urlparse(base_url)
    host = parsed.hostname or "egg-orchestrator"
    port = parsed.port or 9849

    interval = max(interval, 1)

    last_output = None
    consecutive_errors = 0

    while True:
        try:
            # Always fetch status for state tracking
            result = fetch_status(host, port, pipeline_id)
            if result is None:
                consecutive_errors += 1
                if consecutive_errors >= MAX_CONSECUTIVE_ERRORS:
                    _write(
                        f"{RED}Giving up after {MAX_CONSECUTIVE_ERRORS} consecutive errors.{RESET}\n",
                        file=sys.stderr,
                    )
                    return 1
                time.sleep(interval)
                continue
            consecutive_errors = 0

            data = result.get("data", result)
            status = data.get("status", "unknown")

            if compact:
                # Compact mode: single status line (original behavior)
                output = format_status_line(pipeline_id, data)
                if output != last_output:
                    _write(output + "\n")
                    last_output = output
            else:
                # DAG mode: fetch full visualization
                dag = fetch_visualization(host, port, pipeline_id)
                if dag:
                    output = dag.rstrip()
                    if output != last_output:
                        if IS_TTY and last_output is not None:
                            _clear_screen()
                        _write(output + "\n")
                        last_output = output
                else:
                    # Fall back to compact if visualization unavailable
                    output = format_status_line(pipeline_id, data)
                    if output != last_output:
                        _write(output + "\n")
                        last_output = output

            if status in TERMINAL_STATUSES:
                if status == "complete":
                    _write(f"\n{GREEN}Pipeline {pipeline_id} completed.{RESET}\n")
                elif status == "failed":
                    _write(f"\n{RED}Pipeline {pipeline_id} failed.{RESET}\n")
                elif status == "cancelled":
                    _write(f"\n{RED}Pipeline {pipeline_id} cancelled.{RESET}\n")
                return 0 if status == "complete" else 1

            if once:
                return 0

            time.sleep(interval)
        except KeyboardInterrupt:
            _write(f"\n{DIM}Stopped watching.{RESET}\n")
            return 0


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Watch SDLC pipeline progress",
        prog="egg-pipeline-watch",
    )
    parser.add_argument(
        "pipeline_id",
        help="Pipeline ID to watch (e.g., issue-123, local-abc123)",
    )
    parser.add_argument(
        "--interval",
        type=int,
        default=DEFAULT_INTERVAL,
        help=f"Polling interval in seconds (default: {DEFAULT_INTERVAL})",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="Show current state and exit (no polling)",
    )
    parser.add_argument(
        "--compact",
        action="store_true",
        help="Show compact one-line status instead of DAG visualization",
    )

    args = parser.parse_args()

    # Handle SIGPIPE gracefully
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)

    sys.exit(
        watch_pipeline(
            pipeline_id=args.pipeline_id,
            interval=args.interval,
            once=args.once,
            compact=args.compact,
        )
    )


if __name__ == "__main__":
    main()
