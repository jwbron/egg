#!/bin/bash
#
# Jira CLI wrapper for egg container
# Routes Jira commands through the gateway sidecar for policy enforcement.
#
# Security: Requires gateway sidecar - fails closed if gateway unavailable.
# The gateway sidecar holds the Atlassian credentials and enforces policies:
# - Project allowlist restricts which projects agents can access
# - Read-only: only GET operations are permitted
# - JQL scope extraction prevents cross-project data access
#
# Verbs:
#   jira ticket get <KEY> [--fields f1,f2]
#   jira ticket comments <KEY>
#   jira ticket create --project KEY --type Task --summary "..." [opts]
#   jira ticket edit <KEY> [opts]
#   jira ticket comment add <KEY> [--body ... | --body-file F | --body-stdin] [--idempotency-key K]
#   jira link create --type Blocks --inward FOO-1 --outward FOO-2 [opts]
#   jira search <JQL> [--max-results N] [--fields f1,f2] [--next-page-token TOK]
#   jira execute <METHOD> <PATH> [--query key=val,key2=val2]
#   jira help
#

set -euo pipefail

# --- Environment checks (fail closed) ---

if [ -z "${GATEWAY_URL:-}" ]; then
    echo "ERROR: GATEWAY_URL environment variable is not set." >&2
    echo "This variable must be set by the container launcher." >&2
    exit 1
fi

if [ -z "${EGG_SESSION_TOKEN:-}" ]; then
    echo "ERROR: EGG_SESSION_TOKEN environment variable is not set." >&2
    echo "Session token is required for gateway access." >&2
    exit 1
fi

# --- Gateway health check ---

check_gateway_available() {
    if command -v curl >/dev/null 2>&1; then
        curl -s --connect-timeout 2 "${GATEWAY_URL}/api/v1/health" >/dev/null 2>&1
        return $?
    fi
    return 1
}

show_no_gateway_message() {
    cat >&2 << 'EOF'

================================================================================
  GATEWAY SIDECAR NOT AVAILABLE
================================================================================

Cannot run jira command: The gateway sidecar is required but not reachable.

The gateway enforces project allowlist policies and holds Atlassian credentials.
Without it, Jira operations are not allowed.

Please ensure:
  1. Gateway sidecar is running on the host
  2. The container can reach the gateway:
     curl $GATEWAY_URL/api/v1/health

================================================================================

EOF
    exit 1
}

if ! check_gateway_available; then
    show_no_gateway_message
fi

# --- Usage ---

show_usage() {
    cat << 'EOF'
Usage: jira <command> [options]

Read commands:
  jira ticket get <KEY> [--fields f1,f2]
      Fetch a Jira ticket by key (e.g. ENG-123).

  jira ticket comments <KEY>
      Fetch comments on a Jira ticket.

  jira search <JQL> [--max-results N] [--fields f1,f2] [--next-page-token TOK]
      Search for issues using JQL. Project scope is enforced by the gateway.

  jira execute <METHOD> <PATH> [--query key=val,key2=val2]
      Execute a raw read-only Jira REST API call through the gateway.

Write commands (issue #1924):
  jira ticket create --project KEY --type Task --summary "..." \
      [--description ... | --description-file F | --description-stdin] \
      [--labels a,b] [--parent FOO-1] [--epic-link FOO-2] [--idempotency-key K]
      Create a new Jira ticket.

  jira ticket edit <KEY> [--summary "..."] \
      [--description ... | --description-file F | --description-stdin] \
      [--labels a,b] [--add-labels x,y] [--remove-labels z] [--no-notify]
      Edit an existing Jira ticket. --labels (replace) is mutually
      exclusive with --add-labels/--remove-labels (incremental).

  jira ticket comment add <KEY> \
      [--body ... | --body-file F | --body-stdin] [--idempotency-key K]
      Add a comment to a Jira ticket.

  jira link create --type Blocks --inward FOO-1 --outward FOO-2 \
      [--comment ... | --comment-file F | --comment-stdin] [--idempotency-key K]
      Link two Jira tickets.

  jira help
      Show this usage information.
EOF
}

# --- Gateway call helper ---

call_gateway() {
    local endpoint="$1"
    local payload="$2"

    local tmpfile curl_errfile
    tmpfile=$(mktemp)
    curl_errfile=$(mktemp)
    # Use RETURN trap for function-scoped cleanup (not EXIT, which is
    # process-global and would be overwritten by a second call_gateway
    # invocation). Mirrors the pattern in sandbox/scripts/gh line 730.
    # Use ${var:-} to avoid unbound-variable errors if the trap fires in
    # a parent scope after call_gateway returns.
    trap 'rm -f "${tmpfile:-}" "${curl_errfile:-}"' RETURN

    local http_code
    http_code=$(curl -s -w "%{http_code}" \
        -X POST \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer ${EGG_SESSION_TOKEN}" \
        -d "$payload" \
        -o "$tmpfile" \
        "${GATEWAY_URL}${endpoint}" 2>"$curl_errfile")

    local curl_exit=$?
    if [ $curl_exit -ne 0 ]; then
        echo "ERROR: Failed to connect to gateway (curl exit $curl_exit)" >&2
        cat "$curl_errfile" >&2
        return 1
    fi

    # Parse response: on success print .data as JSON to stdout; on failure
    # print error message to stderr and exit non-zero.
    python3 -c "
import json, sys

try:
    with open(sys.argv[1]) as f:
        data = json.load(f)
except (json.JSONDecodeError, OSError) as e:
    print(f'ERROR: Failed to parse gateway response: {e}', file=sys.stderr)
    sys.exit(1)

http_code = sys.argv[2]

if data.get('success'):
    payload = data.get('data', {})
    print(json.dumps(payload, indent=2))
    sys.exit(0)
else:
    message = data.get('message', 'Unknown error')
    details = data.get('details', {})
    print(f'ERROR: {message}', file=sys.stderr)
    if details:
        for k, v in details.items():
            print(f'  {k}: {v}', file=sys.stderr)
    if http_code == '401':
        print('Authentication failed - check session token', file=sys.stderr)
    elif http_code == '429':
        print('Rate limit exceeded - please wait before trying again', file=sys.stderr)
    sys.exit(1)
" "$tmpfile" "$http_code"

    return $?
}

# --- Verb handlers ---

handle_ticket_get() {
    shift  # consume "get"
    if [ $# -lt 1 ]; then
        echo "ERROR: Ticket key required. Usage: jira ticket get <KEY> [--fields f1,f2]" >&2
        exit 1
    fi
    local ticket_key="$1"
    shift

    local fields=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --fields)
                shift
                fields="${1:-}"
                shift || true
                ;;
            *)
                shift
                ;;
        esac
    done

    local payload
    payload=$(python3 -c "
import json, sys
body = {'ticket': sys.argv[1]}
fields = sys.argv[2]
if fields:
    body['fields'] = [f.strip() for f in fields.split(',')]
print(json.dumps(body))
" "$ticket_key" "$fields")

    call_gateway "/api/v1/jira/ticket/get" "$payload"
}

handle_ticket_comments() {
    shift  # consume "comments"
    if [ $# -lt 1 ]; then
        echo "ERROR: Ticket key required. Usage: jira ticket comments <KEY>" >&2
        exit 1
    fi
    local ticket_key="$1"

    local payload
    payload=$(python3 -c "
import json, sys
print(json.dumps({'ticket': sys.argv[1]}))
" "$ticket_key")

    call_gateway "/api/v1/jira/ticket/comments" "$payload"
}

handle_search() {
    if [ $# -lt 1 ]; then
        echo "ERROR: JQL query required. Usage: jira search <JQL> [options]" >&2
        exit 1
    fi
    local jql="$1"
    shift

    local max_results="" fields="" next_page_token=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --max-results)
                shift
                max_results="${1:-}"
                if ! [[ "$max_results" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --max-results must be an integer, got: $max_results" >&2
                    exit 1
                fi
                shift || true
                ;;
            --fields)
                shift
                fields="${1:-}"
                shift || true
                ;;
            --next-page-token)
                shift
                next_page_token="${1:-}"
                shift || true
                ;;
            *)
                shift
                ;;
        esac
    done

    local payload
    payload=$(python3 -c "
import json, sys
body = {'jql': sys.argv[1]}
max_results = sys.argv[2]
fields = sys.argv[3]
next_page_token = sys.argv[4]
if max_results:
    body['maxResults'] = int(max_results)
if fields:
    body['fields'] = [f.strip() for f in fields.split(',')]
if next_page_token:
    body['nextPageToken'] = next_page_token
print(json.dumps(body))
" "$jql" "$max_results" "$fields" "$next_page_token")

    call_gateway "/api/v1/jira/search" "$payload"
}

# Resolve a body text from either a literal value, a file, or stdin.
# Mirrors the "--description / --description-file / --description-stdin"
# pattern used by the gh wrapper. Echoes the resolved text on stdout (may
# be empty when no flag was supplied). Exits non-zero on inconsistent
# combinations or read errors.
resolve_text_input() {
    local label="$1"
    local literal="$2"
    local file_path="$3"
    local from_stdin="$4"

    local count=0
    if [ -n "$literal" ]; then count=$((count + 1)); fi
    if [ -n "$file_path" ]; then count=$((count + 1)); fi
    if [ "$from_stdin" = "1" ]; then count=$((count + 1)); fi

    if [ "$count" -gt 1 ]; then
        echo "ERROR: --${label}, --${label}-file, --${label}-stdin are mutually exclusive" >&2
        return 1
    fi

    if [ -n "$literal" ]; then
        printf '%s' "$literal"
    elif [ -n "$file_path" ]; then
        if [ ! -r "$file_path" ]; then
            echo "ERROR: cannot read --${label}-file: $file_path" >&2
            return 1
        fi
        cat "$file_path"
    elif [ "$from_stdin" = "1" ]; then
        cat
    fi

    return 0
}

handle_ticket_create() {
    shift  # consume "create"
    local project="" issuetype="" summary=""
    local description="" description_file="" description_stdin=0
    local labels="" parent="" epic_link="" idempotency_key=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --project)
                shift
                project="${1:-}"
                shift || true
                ;;
            --type|--issuetype)
                shift
                issuetype="${1:-}"
                shift || true
                ;;
            --summary)
                shift
                summary="${1:-}"
                shift || true
                ;;
            --description)
                shift
                description="${1:-}"
                shift || true
                ;;
            --description-file)
                shift
                description_file="${1:-}"
                shift || true
                ;;
            --description-stdin)
                description_stdin=1
                shift
                ;;
            --labels)
                shift
                labels="${1:-}"
                shift || true
                ;;
            --parent)
                shift
                parent="${1:-}"
                shift || true
                ;;
            --epic-link)
                shift
                epic_link="${1:-}"
                shift || true
                ;;
            --idempotency-key)
                shift
                idempotency_key="${1:-}"
                shift || true
                ;;
            *)
                echo "ERROR: unknown flag for 'jira ticket create': $1" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$project" ] || [ -z "$issuetype" ] || [ -z "$summary" ]; then
        echo "ERROR: --project, --type, and --summary are required" >&2
        exit 1
    fi

    local resolved_description
    if ! resolved_description=$(resolve_text_input description \
        "$description" "$description_file" "$description_stdin"); then
        exit 1
    fi
    local has_description=0
    if [ -n "$description" ] || [ -n "$description_file" ] || [ "$description_stdin" = "1" ]; then
        has_description=1
    fi

    local payload
    payload=$(python3 -c '
import json, sys
body = {
    "project": sys.argv[1],
    "issuetype": sys.argv[2],
    "summary": sys.argv[3],
}
if sys.argv[4] == "1":
    body["description"] = sys.argv[5]
labels_csv = sys.argv[6]
if labels_csv:
    body["labels"] = [v.strip() for v in labels_csv.split(",") if v.strip()]
parent = sys.argv[7]
if parent:
    body["parent"] = parent
epic_link = sys.argv[8]
if epic_link:
    body["epicLink"] = epic_link
idempotency_key = sys.argv[9]
if idempotency_key:
    body["idempotencyKey"] = idempotency_key
print(json.dumps(body))
' "$project" "$issuetype" "$summary" \
       "$has_description" "$resolved_description" \
       "$labels" "$parent" "$epic_link" "$idempotency_key")

    call_gateway "/api/v1/jira/ticket/create" "$payload"
}

handle_ticket_edit() {
    shift  # consume "edit"
    if [ $# -lt 1 ]; then
        echo "ERROR: ticket key required. Usage: jira ticket edit <KEY> [opts]" >&2
        exit 1
    fi
    local ticket="$1"
    shift

    local summary="" labels="" add_labels="" remove_labels=""
    local description="" description_file="" description_stdin=0
    local notify="1"   # 1 = notify (gateway default false; we send true unless --no-notify)
    local has_summary=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --summary)
                shift
                summary="${1:-}"
                has_summary=1
                shift || true
                ;;
            --description)
                shift
                description="${1:-}"
                shift || true
                ;;
            --description-file)
                shift
                description_file="${1:-}"
                shift || true
                ;;
            --description-stdin)
                description_stdin=1
                shift
                ;;
            --labels)
                shift
                labels="${1:-}"
                shift || true
                ;;
            --add-labels)
                shift
                add_labels="${1:-}"
                shift || true
                ;;
            --remove-labels)
                shift
                remove_labels="${1:-}"
                shift || true
                ;;
            --no-notify)
                notify="0"
                shift
                ;;
            --notify)
                notify="1"
                shift
                ;;
            *)
                echo "ERROR: unknown flag for 'jira ticket edit': $1" >&2
                exit 1
                ;;
        esac
    done

    local resolved_description
    if ! resolved_description=$(resolve_text_input description \
        "$description" "$description_file" "$description_stdin"); then
        exit 1
    fi
    local has_description=0
    if [ -n "$description" ] || [ -n "$description_file" ] || [ "$description_stdin" = "1" ]; then
        has_description=1
    fi

    if [ -n "$labels" ] && { [ -n "$add_labels" ] || [ -n "$remove_labels" ]; }; then
        echo "ERROR: --labels (replace) is mutually exclusive with --add-labels/--remove-labels" >&2
        exit 1
    fi

    # The gateway default is notifyUsers=false; we pass an explicit
    # boolean so the wrapper's behaviour is predictable regardless of
    # gateway-side defaults.
    local notify_bool="false"
    if [ "$notify" = "1" ]; then
        notify_bool="true"
    fi

    local payload
    payload=$(python3 -c '
import json, sys
body = {"ticket": sys.argv[1]}
if sys.argv[2] == "1":
    body["summary"] = sys.argv[3]
if sys.argv[4] == "1":
    body["description"] = sys.argv[5]
labels_csv = sys.argv[6]
add_csv = sys.argv[7]
remove_csv = sys.argv[8]
if labels_csv:
    body["labels"] = [v.strip() for v in labels_csv.split(",") if v.strip()]
if add_csv:
    body["addLabels"] = [v.strip() for v in add_csv.split(",") if v.strip()]
if remove_csv:
    body["removeLabels"] = [v.strip() for v in remove_csv.split(",") if v.strip()]
body["notifyUsers"] = (sys.argv[9] == "true")
print(json.dumps(body))
' "$ticket" "$has_summary" "$summary" \
       "$has_description" "$resolved_description" \
       "$labels" "$add_labels" "$remove_labels" "$notify_bool")

    call_gateway "/api/v1/jira/ticket/edit" "$payload"
}

handle_ticket_comment() {
    # NOTE: the outer dispatch in the main case-statement already shifted
    # past "comment" before calling us, so the leading argv here is the
    # subcommand (e.g. "add") followed by the ticket key.  Don't shift
    # again — that would consume "add" and route the ticket key through
    # the unknown-subcommand arm (regression caught by reviewer_code_holistic
    # cycle 1, #1924).
    if [ $# -lt 1 ]; then
        echo "ERROR: missing comment subcommand. Usage: jira ticket comment add <KEY>" >&2
        exit 1
    fi
    case "$1" in
        add)
            handle_ticket_comment_add "$@"
            ;;
        *)
            echo "ERROR: unknown comment subcommand '$1'. Use: add" >&2
            exit 1
            ;;
    esac
}

handle_ticket_comment_add() {
    shift  # consume "add"
    if [ $# -lt 1 ]; then
        echo "ERROR: ticket key required. Usage: jira ticket comment add <KEY> --body ..." >&2
        exit 1
    fi
    local ticket="$1"
    shift

    local body="" body_file="" body_stdin=0 idempotency_key=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --body)
                shift
                body="${1:-}"
                shift || true
                ;;
            --body-file)
                shift
                body_file="${1:-}"
                shift || true
                ;;
            --body-stdin)
                body_stdin=1
                shift
                ;;
            --idempotency-key)
                shift
                idempotency_key="${1:-}"
                shift || true
                ;;
            *)
                echo "ERROR: unknown flag for 'jira ticket comment add': $1" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$body" ] && [ -z "$body_file" ] && [ "$body_stdin" = "0" ]; then
        echo "ERROR: one of --body / --body-file / --body-stdin is required" >&2
        exit 1
    fi

    local resolved_body
    if ! resolved_body=$(resolve_text_input body "$body" "$body_file" "$body_stdin"); then
        exit 1
    fi

    local payload
    payload=$(python3 -c '
import json, sys
body = {"ticket": sys.argv[1], "body": sys.argv[2]}
idempotency_key = sys.argv[3]
if idempotency_key:
    body["idempotencyKey"] = idempotency_key
print(json.dumps(body))
' "$ticket" "$resolved_body" "$idempotency_key")

    call_gateway "/api/v1/jira/ticket/comment/add" "$payload"
}

handle_link_create() {
    shift  # consume "create"
    local link_type="" inward="" outward=""
    local comment="" comment_file="" comment_stdin=0 idempotency_key=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --type)
                shift
                link_type="${1:-}"
                shift || true
                ;;
            --inward|--inward-issue)
                shift
                inward="${1:-}"
                shift || true
                ;;
            --outward|--outward-issue)
                shift
                outward="${1:-}"
                shift || true
                ;;
            --comment)
                shift
                comment="${1:-}"
                shift || true
                ;;
            --comment-file)
                shift
                comment_file="${1:-}"
                shift || true
                ;;
            --comment-stdin)
                comment_stdin=1
                shift
                ;;
            --idempotency-key)
                shift
                idempotency_key="${1:-}"
                shift || true
                ;;
            *)
                echo "ERROR: unknown flag for 'jira link create': $1" >&2
                exit 1
                ;;
        esac
    done

    if [ -z "$link_type" ] || [ -z "$inward" ] || [ -z "$outward" ]; then
        echo "ERROR: --type, --inward, and --outward are required" >&2
        exit 1
    fi

    local resolved_comment
    if ! resolved_comment=$(resolve_text_input comment \
        "$comment" "$comment_file" "$comment_stdin"); then
        exit 1
    fi
    local has_comment=0
    if [ -n "$comment" ] || [ -n "$comment_file" ] || [ "$comment_stdin" = "1" ]; then
        has_comment=1
    fi

    local payload
    payload=$(python3 -c '
import json, sys
body = {
    "type": sys.argv[1],
    "inwardIssue": sys.argv[2],
    "outwardIssue": sys.argv[3],
}
if sys.argv[4] == "1":
    body["comment"] = sys.argv[5]
idempotency_key = sys.argv[6]
if idempotency_key:
    body["idempotencyKey"] = idempotency_key
print(json.dumps(body))
' "$link_type" "$inward" "$outward" \
       "$has_comment" "$resolved_comment" "$idempotency_key")

    call_gateway "/api/v1/jira/issue-link/create" "$payload"
}

handle_link() {
    if [ $# -lt 1 ]; then
        echo "ERROR: missing link subcommand. Usage: jira link create [opts]" >&2
        exit 1
    fi
    case "$1" in
        create)
            handle_link_create "$@"
            ;;
        *)
            echo "ERROR: unknown link subcommand '$1'. Use: create" >&2
            exit 1
            ;;
    esac
}

handle_execute() {
    if [ $# -lt 2 ]; then
        echo "ERROR: Method and path required. Usage: jira execute <METHOD> <PATH> [--query k=v,k2=v2]" >&2
        exit 1
    fi
    local method="$1"
    local api_path="$2"
    shift 2

    local query_str=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --query)
                shift
                query_str="${1:-}"
                shift || true
                ;;
            *)
                shift
                ;;
        esac
    done

    local payload
    payload=$(python3 -c "
import json, sys
body = {'method': sys.argv[1], 'path': sys.argv[2]}
query_str = sys.argv[3]
if query_str:
    query = {}
    for pair in query_str.split(','):
        if '=' in pair:
            k, v = pair.split('=', 1)
            query[k.strip()] = v.strip()
    body['query'] = query
print(json.dumps(body))
" "$method" "$api_path" "$query_str")

    call_gateway "/api/v1/jira/execute" "$payload"
}

# --- Main dispatch ---

if [ $# -lt 1 ]; then
    show_usage >&2
    exit 1
fi

case "$1" in
    ticket)
        shift
        if [ $# -lt 1 ]; then
            echo "ERROR: Missing ticket subcommand. Usage: jira ticket get|comments|create|edit|comment <KEY>" >&2
            exit 1
        fi
        case "$1" in
            get)
                handle_ticket_get "$@"
                ;;
            comments)
                handle_ticket_comments "$@"
                ;;
            create)
                handle_ticket_create "$@"
                ;;
            edit)
                handle_ticket_edit "$@"
                ;;
            comment)
                shift
                handle_ticket_comment "$@"
                ;;
            *)
                echo "ERROR: Unknown ticket subcommand '$1'. Use: get, comments, create, edit, comment" >&2
                exit 1
                ;;
        esac
        ;;
    link)
        shift
        handle_link "$@"
        ;;
    search)
        shift
        handle_search "$@"
        ;;
    execute)
        shift
        handle_execute "$@"
        ;;
    help|--help|-h)
        show_usage
        exit 0
        ;;
    *)
        echo "ERROR: Unknown command '$1'. Use: ticket, link, search, execute, help" >&2
        exit 1
        ;;
esac
