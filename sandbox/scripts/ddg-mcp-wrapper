#!/bin/bash
# Conditional MCP wrapper for DuckDuckGo search.
#
# Active only when routing through LiteLLM to a non-Anthropic model
# (Qwen, DeepSeek, etc.). Exits cleanly on first-party Claude routing
# to leave the built-in WebSearch/WebFetch tools available and avoid
# running an unneeded MCP server process.

if [[ -n "$ANTHROPIC_CUSTOM_MODEL_OPTION" ]]; then
  exec duckduckgo-mcp-server "$@"
else
  exit 0
fi
