# Function to handle issue edit - uses proper JSON escaping
# This is the key fix for issue #180 - prevents body wipe due to shell escaping issues
handle_issue_edit() {
    local repo
    repo=$(get_repo)

    if [ -z "$repo" ]; then
        echo "ERROR: Could not determine repository" >&2
        return 1
    fi

    # Parse args for issue number, title, body
    local issue_number="" title="" body="" add_label="" remove_label="" add_assignee="" remove_assignee=""

    local i=0
    while [ $i -lt ${#ARGS[@]} ]; do
        case "${ARGS[$i]}" in
            --title|-t)
                ((i++))
                title="${ARGS[$i]}"
                ;;
            --body|-b)
                ((i++))
                body="${ARGS[$i]}"
                ;;
            --add-label)
                ((i++))
                if [ -n "$add_label" ]; then
                    add_label="$add_label,${ARGS[$i]}"
                else
                    add_label="${ARGS[$i]}"
                fi
                ;;
            --remove-label)
                ((i++))
                if [ -n "$remove_label" ]; then
                    remove_label="$remove_label,${ARGS[$i]}"
                else
                    remove_label="${ARGS[$i]}"
                fi
                ;;
            --add-assignee)
                ((i++))
                if [ -n "$add_assignee" ]; then
                    add_assignee="$add_assignee,${ARGS[$i]}"
                else
                    add_assignee="${ARGS[$i]}"
                fi
                ;;
            --remove-assignee)
                ((i++))
                if [ -n "$remove_assignee" ]; then
                    remove_assignee="$remove_assignee,${ARGS[$i]}"
                else
                    remove_assignee="${ARGS[$i]}"
                fi
                ;;
            [0-9]*)
                if [ -z "$issue_number" ]; then
                    issue_number="${ARGS[$i]}"
                fi
                ;;
        esac
        ((i++))
    done

    if [ -z "$issue_number" ]; then
        echo "ERROR: Missing issue number" >&2
        return 1
    fi

    # Build args array for gateway execute with properly escaped content
    local escaped_args
    escaped_args=$(python3 -c "
import json
import sys

issue_number = sys.argv[2]
title = sys.argv[3]
body = sys.argv[4]
add_labels = sys.argv[5]
remove_labels = sys.argv[6]
add_assignees = sys.argv[7]
remove_assignees = sys.argv[8]

args = ['issue', 'edit', issue_number, '--repo', sys.argv[1]]

if title:
    args.extend(['--title', title])
if body:
    args.extend(['--body', body])
if add_labels:
    for label in add_labels.split(','):
        args.extend(['--add-label', label])
if remove_labels:
    for label in remove_labels.split(','):
        args.extend(['--remove-label', label])
if add_assignees:
    for assignee in add_assignees.split(','):
        args.extend(['--add-assignee', assignee])
if remove_assignees:
    for assignee in remove_assignees.split(','):
        args.extend(['--remove-assignee', assignee])

print(json.dumps({'args': args}))
" "$repo" "$issue_number" "$title" "$body" "$add_label" "$remove_label" "$add_assignee" "$remove_assignee")

    call_gateway "/api/v1/gh/execute" "$escaped_args"
}

# Function to handle issue close - uses proper JSON escaping
handle_issue_close() {
    local repo
    repo=$(get_repo)

    if [ -z "$repo" ]; then
        echo "ERROR: Could not determine repository" >&2
        return 1
    fi

    # Parse args for issue number and reason
    local issue_number="" reason=""

    local i=0
    while [ $i -lt ${#ARGS[@]} ]; do
        case "${ARGS[$i]}" in
            --reason|-r)
                ((i++))
                reason="${ARGS[$i]}"
                ;;
            [0-9]*)
                if [ -z "$issue_number" ]; then
                    issue_number="${ARGS[$i]}"
                fi
                ;;
        esac
        ((i++))
    done

    if [ -z "$issue_number" ]; then
        echo "ERROR: Missing issue number" >&2
        return 1
    fi

    # Build args array for gateway execute with properly escaped content
    local escaped_args
    escaped_args=$(python3 -c "
import json
import sys

issue_number = sys.argv[2]
reason = sys.argv[3]

args = ['issue', 'close', issue_number, '--repo', sys.argv[1]]

if reason:
    args.extend(['--reason', reason])

print(json.dumps({'args': args}))
" "$repo" "$issue_number" "$reason")

    call_gateway "/api/v1/gh/execute" "$escaped_args"
}

# Function to execute via gateway passthrough - uses proper JSON escaping
execute_via_gateway() {
    local container_cwd
    local cwd
    container_cwd=$(pwd)
    # Translate container path to host path for gateway
    cwd=$(translate_path_for_gateway "$container_cwd")

    # Detect repo from container context (the gateway can't auto-detect it)
    # This runs git in the container where the worktree structure is available
    local repo
    repo=$(get_repo)

    # Build JSON payload using Python for proper escaping
    # Include repo so gateway can inject --repo if needed
    local payload
    payload=$(python3 -c "
import json
import sys
args = sys.argv[3:]
data = {
    'args': args,
    'cwd': sys.argv[1]
}
# Include repo if detected (gateway will inject --repo if not in args)
if sys.argv[2]:
    data['repo'] = sys.argv[2]
print(json.dumps(data))
" "$cwd" "$repo" "${ARGS[@]}")

    call_gateway "/api/v1/gh/execute" "$payload"
}

# Store original args
ARGS=("$@")

# Unescape \! → ! in all arguments.
# Claude Code's Bash tool escapes ! to \! in command strings. Since this script
# runs as non-interactive bash (#!/bin/bash), the backslash is not consumed as
# a history-expansion escape — it remains as a literal character. This breaks
# jq expressions (e.g., != becomes \!=) and other arguments containing !.
for i in "${!ARGS[@]}"; do
    ARGS[$i]="${ARGS[$i]//\\!/!}"
done
set -- "${ARGS[@]}"

# Parse the main command
main_cmd=""
sub_cmd=""
for arg in "$@"; do
    if [[ "$arg" != -* ]]; then
        if [ -z "$main_cmd" ]; then
            main_cmd="$arg"
        elif [ -z "$sub_cmd" ]; then
            sub_cmd="$arg"
            break
        fi
    fi
done

# Check for merge command - always blocked
if [ "$main_cmd" = "pr" ] && [ "$sub_cmd" = "merge" ]; then
    show_merge_blocked_message
    exit 1
fi

# Gateway is REQUIRED - fail closed if not available
if ! check_gateway_available; then
    show_no_gateway_message
    exit 1
fi

# Route commands through gateway
case "$main_cmd" in
    pr)
        case "$sub_cmd" in
            create)
                handle_pr_create
                exit $?
                ;;
            comment)
                handle_pr_comment
                exit $?
                ;;
            edit)
                handle_pr_edit
                exit $?
                ;;
            close)
                handle_pr_close
                exit $?
                ;;
            review)
                handle_pr_review
                exit $?
                ;;
            *)
                # Other PR commands - pass through via gateway execute
                execute_via_gateway
                exit $?
                ;;
        esac
        ;;
    issue)
        # Issue commands use dedicated handlers for proper JSON escaping
        # This prevents body content from being wiped due to shell escaping issues (issue #180)
        case "$sub_cmd" in
            create)
                handle_issue_create
                exit $?
                ;;
            comment)
                handle_issue_comment
                exit $?
                ;;
            edit)
                handle_issue_edit
                exit $?
                ;;
            close)
                handle_issue_close
                exit $?
                ;;
            *)
                # Other issue commands - pass through via gateway execute
                execute_via_gateway
                exit $?
                ;;
        esac
        ;;
    *)
        # All other commands - pass through via gateway execute
        execute_via_gateway
        exit $?
        ;;
esac
