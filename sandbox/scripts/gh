args = ['issue', 'comment', sys.argv[2], '--repo', sys.argv[1], '--body', sys.argv[3]]
print(json.dumps({'args': args}))
" "$repo" "$issue_number" "$body")

    call_gateway "/api/v1/gh/execute" "$escaped_args"
