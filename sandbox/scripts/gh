            [0-9]*)
                if [ -z "$issue_number" ]; then
                    issue_number="${ARGS[$i]}"
                fi
                ;;
        esac
        ((i++))
    done

    if [ -z "$issue_number" ]; then
        echo "ERROR: Missing issue number" >&2
        return 1
    fi

    if [ -z "$body" ]; then
        echo "ERROR: Missing --body for issue comment" >&2
        return 1
    fi

    # Build args array for gateway execute with properly escaped content
    local escaped_args
    escaped_args=$(python3 -c "
import json
