{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jwbron/egg/schemas/contract.schema.json",
  "title": "SDLC Contract",
  "description": "Contract schema for structurally enforced agent checkpoints and verification gates",
  "type": "object",
  "required": ["schemaVersion", "issue", "phases", "decisions", "audit_log"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version for migrations",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "default": "1.0"
    },
    "issue": {
      "type": "object",
      "description": "Issue metadata",
      "required": ["number", "title", "url"],
      "properties": {
        "number": {
          "type": "integer",
          "description": "GitHub issue number",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "description": "Issue title",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "description": "Issue URL",
          "format": "uri"
        }
      },
      "additionalProperties": false
    },
    "current_phase": {
      "type": "string",
      "description": "Current pipeline phase",
      "enum": ["refine", "plan", "implement", "pr"],
      "default": "refine"
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "Top-level acceptance criteria",
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      },
      "default": []
    },
    "phases": {
      "type": "array",
      "description": "Implementation phases with tasks",
      "items": {
        "$ref": "#/$defs/phase"
      },
      "default": []
    },
    "decisions": {
      "type": "array",
      "description": "HITL decision points",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "default": []
    },
    "circuit_breaker": {
      "$ref": "#/$defs/circuitBreaker"
    },
    "workflow_owner": {
      "type": ["string", "null"],
      "description": "GitHub username of the user who initiated the SDLC workflow (added the sdlc:refine label)",
      "default": null
    },
    "audit_log": {
      "type": "array",
      "description": "Audit trail of all modifications",
      "items": {
        "$ref": "#/$defs/auditEntry"
      },
      "default": []
    },
    "refine_review_cycles": {
      "type": "integer",
      "description": "Number of refine phase review cycles",
      "minimum": 0,
      "default": 0
    },
    "refine_review_feedback": {
      "type": "string",
      "description": "Feedback from last refine review",
      "default": ""
    },
    "plan_review_cycles": {
      "type": "integer",
      "description": "Number of plan phase review cycles",
      "minimum": 0,
      "default": 0
    },
    "plan_review_feedback": {
      "type": "string",
      "description": "Feedback from last plan review",
      "default": ""
    },
    "pr": {
      "oneOf": [
        { "$ref": "#/$defs/prMetadata" },
        { "type": "null" }
      ],
      "description": "Planner-generated PR metadata for use during PR creation",
      "default": null
    },
    "feedback": {
      "oneOf": [
        { "$ref": "#/$defs/feedback" },
        { "type": "null" }
      ],
      "description": "Active feedback request for collecting open-ended questions from humans",
      "default": null
    },
    "phase_config": {
      "$ref": "#/$defs/phaseConfigMap",
      "description": "Configuration for work loop phases (refine, plan, implement)"
    },
    "work_loop_state": {
      "oneOf": [
        { "$ref": "#/$defs/workLoopState" },
        { "type": "null" }
      ],
      "description": "Current state of the work loop execution",
      "default": null
    }
  },
  "additionalProperties": false,
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "required": ["id", "description", "verified"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (e.g., ac-1)",
          "pattern": "^ac-[0-9]+$"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description",
          "minLength": 1
        },
        "verified": {
          "type": "boolean",
          "description": "Whether this criterion has been verified",
          "default": false,
          "x-role-owner": "reviewer"
        }
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "object",
      "required": ["id", "name", "status", "tasks"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique phase identifier (e.g., phase-1)",
          "pattern": "^phase-[0-9]+$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable phase name",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "description": "Phase status",
          "enum": ["pending", "in_progress", "complete", "blocked"],
          "default": "pending",
          "x-role-owner": "reviewer"
        },
        "review_cycles": {
          "type": "integer",
          "description": "Number of implement->review cycles",
          "minimum": 0,
          "default": 0
        },
        "max_cycles": {
          "type": "integer",
          "description": "Maximum cycles before escalation",
          "minimum": 1,
          "default": 3
        },
        "escalated": {
          "type": "boolean",
          "description": "Whether this phase has been escalated",
          "default": false
        },
        "escalation_reason": {
          "type": ["string", "null"],
          "description": "Reason for escalation",
          "default": null
        },
        "tasks": {
          "type": "array",
          "description": "Tasks in this phase",
          "items": {
            "$ref": "#/$defs/task"
          },
          "default": []
        },
        "review_feedback": {
          "type": "array",
          "description": "Feedback from reviewer",
          "items": {
            "$ref": "#/$defs/reviewFeedback"
          },
          "default": [],
          "x-role-owner": "reviewer"
        }
      },
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": ["id", "description", "status"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task identifier (e.g., task-1)",
          "pattern": "^task-[0-9]+(-[0-9]+)?$"
        },
        "description": {
          "type": "string",
          "description": "Task description",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "description": "Task status",
          "enum": ["pending", "in_progress", "complete", "incomplete", "blocked"],
          "default": "pending",
          "x-role-owner": "reviewer"
        },
        "commit": {
          "type": ["string", "null"],
          "description": "Git commit SHA linked to this task",
          "pattern": "^[a-f0-9]{7,40}$",
          "default": null,
          "x-role-owner": "implementer"
        },
        "notes": {
          "type": "string",
          "description": "Implementation notes",
          "default": "",
          "x-role-owner": "implementer"
        },
        "acceptance_criteria": {
          "type": "string",
          "description": "Acceptance criteria for this task",
          "default": ""
        },
        "files_affected": {
          "type": "array",
          "description": "Files affected by this task",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "review_cycles": {
          "type": "integer",
          "description": "Number of review cycles for this task",
          "minimum": 0,
          "default": 0
        },
        "max_cycles": {
          "type": "integer",
          "description": "Maximum cycles before escalation",
          "minimum": 1,
          "default": 3
        },
        "escalated": {
          "type": "boolean",
          "description": "Whether this task has been escalated",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "reviewFeedback": {
      "type": "object",
      "required": ["timestamp", "task_id", "feedback"],
      "properties": {
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp",
          "format": "date-time"
        },
        "task_id": {
          "type": "string",
          "description": "Task this feedback applies to"
        },
        "feedback": {
          "type": "string",
          "description": "Reviewer feedback",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "description": "Status assigned by reviewer",
          "enum": ["complete", "incomplete"]
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["id", "question", "type", "resolved"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique decision identifier (e.g., decision-1)",
          "pattern": "^decision-[0-9]+$"
        },
        "question": {
          "type": "string",
          "description": "The decision question",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "description": "Decision type",
          "enum": ["hitl", "auto"]
        },
        "options": {
          "type": "array",
          "description": "Available options for the decision",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "resolved": {
          "type": "boolean",
          "description": "Whether this decision has been resolved",
          "default": false,
          "x-role-owner": "human"
        },
        "resolution": {
          "type": ["string", "null"],
          "description": "The selected resolution",
          "default": null,
          "x-role-owner": "human"
        },
        "resolved_by": {
          "type": ["string", "null"],
          "description": "Who resolved this decision",
          "default": null
        },
        "resolved_at": {
          "type": ["string", "null"],
          "description": "When this decision was resolved",
          "format": "date-time",
          "default": null
        },
        "debounce_until": {
          "type": ["string", "null"],
          "description": "Debounce expiration timestamp",
          "format": "date-time",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "circuitBreaker": {
      "type": "object",
      "properties": {
        "total_cycles": {
          "type": "integer",
          "description": "Total pipeline cycles",
          "minimum": 0,
          "default": 0
        },
        "max_total_cycles": {
          "type": "integer",
          "description": "Maximum total cycles before escalation",
          "minimum": 1,
          "default": 10
        },
        "status": {
          "type": "string",
          "description": "Circuit breaker status",
          "enum": ["closed", "open"],
          "default": "closed"
        }
      },
      "additionalProperties": false
    },
    "prMetadata": {
      "type": "object",
      "description": "Planner-generated PR title and description",
      "required": ["title"],
      "properties": {
        "title": {
          "type": "string",
          "description": "PR title (recommended max 70 characters for readability)",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "PR description/body explaining the context and changes",
          "default": ""
        }
      },
      "additionalProperties": false
    },
    "feedbackQuestion": {
      "type": "object",
      "description": "A question for human feedback",
      "required": ["id", "question"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique question identifier (e.g., Q1)",
          "pattern": "^Q[0-9]+$"
        },
        "question": {
          "type": "string",
          "description": "The question text",
          "minLength": 1
        },
        "answer": {
          "type": ["string", "null"],
          "description": "Human-provided answer (free-form text)",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "feedback": {
      "type": "object",
      "description": "Feedback request for collecting open-ended questions from humans",
      "required": ["id", "questions", "submitted"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique feedback identifier (e.g., feedback-1)",
          "pattern": "^feedback-[0-9]+$"
        },
        "phase": {
          "type": "string",
          "description": "Pipeline phase this feedback belongs to",
          "enum": ["refine", "plan", "implement", "pr"]
        },
        "questions": {
          "type": "array",
          "description": "List of questions for the human",
          "items": {
            "$ref": "#/$defs/feedbackQuestion"
          },
          "minItems": 1
        },
        "submitted": {
          "type": "boolean",
          "description": "Whether the feedback has been submitted",
          "default": false,
          "x-role-owner": "human"
        },
        "submitted_by": {
          "type": ["string", "null"],
          "description": "GitHub username who submitted the feedback",
          "default": null
        },
        "submitted_at": {
          "type": ["string", "null"],
          "description": "When the feedback was submitted",
          "format": "date-time",
          "default": null
        },
        "comment_id": {
          "type": ["integer", "null"],
          "description": "GitHub comment ID containing this feedback",
          "default": null
        },
        "debounce_until": {
          "type": ["string", "null"],
          "description": "Debounce expiration timestamp",
          "format": "date-time",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "auditEntry": {
      "type": "object",
      "required": ["timestamp", "actor", "role", "action", "field_path"],
      "properties": {
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp",
          "format": "date-time"
        },
        "actor": {
          "type": "string",
          "description": "Who performed the action"
        },
        "role": {
          "type": "string",
          "description": "Role of the actor",
          "enum": ["implementer", "reviewer", "human", "system"]
        },
        "action": {
          "type": "string",
          "description": "Action performed",
          "enum": ["create", "update", "delete", "transition"]
        },
        "field_path": {
          "type": "string",
          "description": "JSON path of the modified field"
        },
        "old_value": {
          "description": "Previous value (if applicable)"
        },
        "new_value": {
          "description": "New value"
        },
        "reason": {
          "type": "string",
          "description": "Reason for the change"
        }
      },
      "additionalProperties": false
    },
    "intermediateCheck": {
      "type": "object",
      "description": "A check to run between producer and reviewer steps in the work loop",
      "required": ["id", "name", "command"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique check identifier (e.g., check-lint, check-test)",
          "pattern": "^check-[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "description": "Human-readable check name",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "description": "Shell command or workflow reference to execute (e.g., 'make lint' or 'workflow:reusable-autofix.yml')",
          "minLength": 1
        },
        "auto_fix": {
          "type": "boolean",
          "description": "Whether this check supports automatic fixing",
          "default": false
        },
        "auto_fix_command": {
          "type": ["string", "null"],
          "description": "Command to run for automatic fixing (if auto_fix is true)",
          "default": null
        },
        "depends_on": {
          "type": "array",
          "description": "IDs of checks that must complete before this one (DAG dependencies)",
          "items": {
            "type": "string",
            "pattern": "^check-[a-z0-9-]+$"
          },
          "default": []
        },
        "required": {
          "type": "boolean",
          "description": "Whether this check must pass for the work loop to proceed",
          "default": true
        },
        "timeout_minutes": {
          "type": "integer",
          "description": "Maximum time for this check to complete",
          "minimum": 1,
          "default": 30
        }
      },
      "additionalProperties": false
    },
    "checkResult": {
      "type": "object",
      "description": "Result of running an intermediate check",
      "required": ["check_id", "status"],
      "properties": {
        "check_id": {
          "type": "string",
          "description": "ID of the check that was run",
          "pattern": "^check-[a-z0-9-]+$"
        },
        "status": {
          "type": "string",
          "description": "Check result status",
          "enum": ["pending", "running", "passed", "failed", "skipped", "fixed"]
        },
        "started_at": {
          "type": ["string", "null"],
          "description": "When the check started",
          "format": "date-time",
          "default": null
        },
        "completed_at": {
          "type": ["string", "null"],
          "description": "When the check completed",
          "format": "date-time",
          "default": null
        },
        "output": {
          "type": "string",
          "description": "Check output or error message",
          "default": ""
        },
        "auto_fix_attempted": {
          "type": "boolean",
          "description": "Whether auto-fix was attempted",
          "default": false
        },
        "auto_fix_commit": {
          "type": ["string", "null"],
          "description": "Commit SHA of auto-fix changes if any",
          "pattern": "^[a-f0-9]{7,40}$",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "phaseConfig": {
      "type": "object",
      "description": "Configuration for a single work loop phase (refine, plan, or implement)",
      "required": ["producer_prompt_script", "max_cycles"],
      "properties": {
        "producer_prompt_script": {
          "type": "string",
          "description": "Path to the script that builds the producer agent prompt",
          "minLength": 1
        },
        "producer_timeout_minutes": {
          "type": "integer",
          "description": "Timeout for producer agent execution",
          "minimum": 1,
          "default": 60
        },
        "reviewer_prompt_script": {
          "type": ["string", "null"],
          "description": "Path to the script that builds the reviewer agent prompt (null for PR-based review)",
          "default": null
        },
        "reviewer_timeout_minutes": {
          "type": "integer",
          "description": "Timeout for reviewer agent execution",
          "minimum": 1,
          "default": 30
        },
        "max_cycles": {
          "type": "integer",
          "description": "Maximum work-review cycles before escalation",
          "minimum": 1,
          "default": 3
        },
        "intermediate_checks": {
          "type": "array",
          "description": "Checks to run between producer and reviewer steps",
          "items": {
            "$ref": "#/$defs/intermediateCheck"
          },
          "default": []
        },
        "human_review_mechanism": {
          "type": "string",
          "description": "How human review is collected for this phase",
          "enum": ["issue_comment", "pr_review"],
          "default": "issue_comment"
        },
        "output_artifact_path": {
          "type": ["string", "null"],
          "description": "Path pattern for the phase output artifact (e.g., .egg-state/drafts/{issue}-analysis.md)",
          "default": null
        },
        "post_producer_script": {
          "type": ["string", "null"],
          "description": "Optional script to run after producer completes (e.g., populate-contract-tasks.py)",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "phaseConfigMap": {
      "type": "object",
      "description": "Map of phase configurations keyed by phase name",
      "properties": {
        "refine": {
          "$ref": "#/$defs/phaseConfig"
        },
        "plan": {
          "$ref": "#/$defs/phaseConfig"
        },
        "implement": {
          "$ref": "#/$defs/phaseConfig"
        }
      },
      "additionalProperties": false
    },
    "workLoopState": {
      "type": "object",
      "description": "Current state of work loop execution within a phase",
      "required": ["phase", "cycle", "step"],
      "properties": {
        "phase": {
          "type": "string",
          "description": "Current work loop phase",
          "enum": ["refine", "plan", "implement"]
        },
        "cycle": {
          "type": "integer",
          "description": "Current cycle number (1-indexed)",
          "minimum": 1
        },
        "step": {
          "type": "string",
          "description": "Current step within the cycle",
          "enum": ["producer", "intermediate_checks", "reviewer", "decision", "human_review"]
        },
        "check_results": {
          "type": "array",
          "description": "Results of intermediate checks in current cycle",
          "items": {
            "$ref": "#/$defs/checkResult"
          },
          "default": []
        },
        "last_producer_output": {
          "type": ["string", "null"],
          "description": "Path to or content of last producer output",
          "default": null
        },
        "last_reviewer_verdict": {
          "type": ["string", "null"],
          "description": "Verdict from last reviewer (approved, rejected, escalate)",
          "enum": ["approved", "rejected", "escalate", null],
          "default": null
        },
        "last_reviewer_feedback": {
          "type": "string",
          "description": "Feedback from last reviewer",
          "default": ""
        },
        "human_feedback_pending": {
          "type": "boolean",
          "description": "Whether waiting for human feedback",
          "default": false
        },
        "started_at": {
          "type": ["string", "null"],
          "description": "When this work loop iteration started",
          "format": "date-time",
          "default": null
        }
      },
      "additionalProperties": false
    }
  }
}
