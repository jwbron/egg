{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jwbron/egg/schemas/checkpoint.schema.json",
  "title": "Agent Checkpoint V2",
  "description": "Schema for capturing agent session context as versioned data in Git. V2 supports session-end checkpoints, multi-dimensional indexing, and pipeline correlation.",
  "type": "object",
  "required": ["schemaVersion", "id", "trigger_type", "session_id", "session", "created_at", "session_started_at"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Schema version for migrations",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "default": "2.0"
    },
    "id": {
      "type": "string",
      "description": "Unique checkpoint identifier",
      "pattern": "^ckpt-[a-f0-9]{8,16}$"
    },
    "trigger_type": {
      "type": "string",
      "description": "What triggered checkpoint creation",
      "enum": ["commit", "session_end"]
    },
    "session_status": {
      "type": ["string", "null"],
      "description": "Terminal session state (only for session_end triggers)",
      "enum": ["completed", "expired", "failed", null],
      "default": null
    },
    "commit_sha": {
      "type": ["string", "null"],
      "description": "Git commit SHA (optional in v2, not present for session-end checkpoints)",
      "pattern": "^[a-f0-9]{7,40}$",
      "default": null
    },
    "push_sha": {
      "type": ["string", "null"],
      "description": "The tip commit SHA of the push that triggered this checkpoint",
      "pattern": "^[a-f0-9]{7,40}$",
      "default": null
    },
    "branch": {
      "type": ["string", "null"],
      "description": "Git branch where the commit was made",
      "default": null
    },
    "session_id": {
      "type": "string",
      "description": "Session/container ID for direct indexing"
    },
    "issue_number": {
      "type": ["integer", "null"],
      "description": "GitHub issue number if associated with an issue",
      "minimum": 1,
      "default": null
    },
    "pr_number": {
      "type": ["integer", "null"],
      "description": "GitHub PR number if associated with a pull request",
      "minimum": 1,
      "default": null
    },
    "agent_type": {
      "type": "string",
      "description": "Agent role classification",
      "enum": ["coder", "tester", "documenter", "integrator", "reviewer", "architect", "task_planner", "risk_analyst", "refiner", "checker", "unknown"],
      "default": "unknown"
    },
    "pipeline_phase": {
      "type": ["string", "null"],
      "description": "SDLC pipeline phase when checkpoint was created",
      "enum": ["refine", "plan", "implement", "pr", null],
      "default": null
    },
    "pipeline_id": {
      "type": ["string", "null"],
      "description": "Pipeline run ID for multi-agent workflow correlation",
      "default": null
    },
    "session": {
      "$ref": "#/$defs/sessionMetadata"
    },
    "transcript": {
      "$ref": "#/$defs/transcript"
    },
    "files_touched": {
      "type": "array",
      "description": "Files that were read, created, or edited during the session",
      "items": {
        "$ref": "#/$defs/fileOperation"
      },
      "default": []
    },
    "tool_calls": {
      "type": "array",
      "description": "Tool invocations made during the session",
      "items": {
        "$ref": "#/$defs/toolCall"
      },
      "default": []
    },
    "token_usage": {
      "$ref": "#/$defs/tokenUsage"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when checkpoint was created",
      "format": "date-time"
    },
    "session_started_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the session started",
      "format": "date-time"
    },
    "session_ended_at": {
      "type": ["string", "null"],
      "description": "ISO 8601 timestamp when the session ended",
      "format": "date-time",
      "default": null
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sessionMetadata": {
      "type": "object",
      "description": "Metadata about the agent session",
      "required": ["session_id", "started_at"],
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Claude Code session ID or container session ID"
        },
        "container_id": {
          "type": ["string", "null"],
          "description": "Docker container ID if running in egg sandbox",
          "default": null
        },
        "agent_role": {
          "type": ["string", "null"],
          "description": "Agent role (e.g., coder, tester, documenter, integrator)",
          "enum": ["coder", "tester", "documenter", "integrator", "reviewer", "architect", "task_planner", "risk_analyst", "refiner", "checker", "reviewer_unified", "reviewer_code", "reviewer_contract", "reviewer_agent_design", "reviewer_refine", "reviewer_plan", null],
          "default": null
        },
        "started_at": {
          "type": "string",
          "description": "ISO 8601 timestamp when session started",
          "format": "date-time"
        },
        "ended_at": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp when session ended",
          "format": "date-time",
          "default": null
        },
        "duration_seconds": {
          "type": ["number", "null"],
          "description": "Session duration in seconds",
          "minimum": 0,
          "default": null
        },
        "model": {
          "type": ["string", "null"],
          "description": "Model used for the session (e.g., claude-opus-4-5-20251101)",
          "default": null
        },
        "claude_code_version": {
          "type": ["string", "null"],
          "description": "Claude Code version if available",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "transcript": {
      "type": "object",
      "description": "The conversation transcript",
      "properties": {
        "messages": {
          "type": "array",
          "description": "Conversation messages",
          "items": {
            "$ref": "#/$defs/message"
          },
          "default": []
        },
        "message_count": {
          "type": "integer",
          "description": "Total number of messages in the transcript",
          "minimum": 0,
          "default": 0
        },
        "truncated": {
          "type": "boolean",
          "description": "Whether the transcript was truncated due to size",
          "default": false
        },
        "truncation_reason": {
          "type": ["string", "null"],
          "description": "Reason for truncation if truncated",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "message": {
      "type": "object",
      "description": "A single message in the transcript",
      "required": ["role", "timestamp"],
      "properties": {
        "role": {
          "type": "string",
          "description": "Message role",
          "enum": ["user", "assistant", "system", "tool_result"]
        },
        "content": {
          "type": ["string", "null"],
          "description": "Message content (may be null for tool calls)",
          "default": null
        },
        "content_summary": {
          "type": ["string", "null"],
          "description": "Summary if content was too large to include",
          "default": null
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp",
          "format": "date-time"
        },
        "uuid": {
          "type": ["string", "null"],
          "description": "Message UUID from Claude Code if available",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "fileOperation": {
      "type": "object",
      "description": "A file operation during the session",
      "required": ["path", "operation"],
      "properties": {
        "path": {
          "type": "string",
          "description": "File path (relative to repo root)"
        },
        "operation": {
          "type": "string",
          "description": "Type of operation",
          "enum": ["read", "write", "edit", "create", "delete", "glob", "grep"]
        },
        "timestamp": {
          "type": ["string", "null"],
          "description": "ISO 8601 timestamp of the operation",
          "format": "date-time",
          "default": null
        }
      },
      "additionalProperties": false
    },
    "toolCall": {
      "type": "object",
      "description": "A tool invocation during the session",
      "required": ["name", "timestamp"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Tool name (e.g., Bash, Read, Write, Edit, Grep, Glob)"
        },
        "tool_use_id": {
          "type": ["string", "null"],
          "description": "Tool use ID from Claude API",
          "default": null
        },
        "parameters": {
          "type": "object",
          "description": "Tool parameters (may be redacted)",
          "additionalProperties": true,
          "default": {}
        },
        "result_summary": {
          "type": ["string", "null"],
          "description": "Summary of tool result (may be truncated/redacted)",
          "default": null
        },
        "success": {
          "type": ["boolean", "null"],
          "description": "Whether the tool call succeeded",
          "default": null
        },
        "duration_ms": {
          "type": ["number", "null"],
          "description": "Tool execution duration in milliseconds",
          "minimum": 0,
          "default": null
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp of the tool call",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "tokenUsage": {
      "type": "object",
      "description": "Token usage for the session",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "description": "Total input tokens",
          "minimum": 0,
          "default": 0
        },
        "output_tokens": {
          "type": "integer",
          "description": "Total output tokens",
          "minimum": 0,
          "default": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "description": "Tokens read from cache",
          "minimum": 0,
          "default": 0
        },
        "cache_creation_tokens": {
          "type": "integer",
          "description": "Tokens written to cache",
          "minimum": 0,
          "default": 0
        },
        "total_tokens": {
          "type": "integer",
          "description": "Total tokens (input + output)",
          "minimum": 0,
          "default": 0
        },
        "estimated_cost_usd": {
          "type": ["number", "null"],
          "description": "Estimated cost in USD",
          "minimum": 0,
          "default": null
        }
      },
      "additionalProperties": false
    }
  }
}
