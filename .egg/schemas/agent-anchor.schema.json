{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jwbron/egg/schemas/agent-anchor.schema.json",
  "title": "Agent Anchor",
  "description": "Agent anchor schema for post-compaction state recovery. Captures working state at natural milestones.",
  "type": "object",
  "required": [
    "_meta",
    "agent_id",
    "role",
    "team",
    "task",
    "status",
    "pipeline_id",
    "progress",
    "decisions",
    "brc_state",
    "key_context",
    "errors_encountered",
    "files_modified"
  ],
  "properties": {
    "_meta": {
      "$ref": "#/$defs/meta"
    },
    "agent_id": {
      "type": "string",
      "description": "Unique identifier for the agent"
    },
    "role": {
      "type": "string",
      "description": "Agent role (e.g., coder, tester)"
    },
    "team": {
      "type": "array",
      "description": "Other agents in the pipeline",
      "items": {
        "type": "string"
      }
    },
    "task": {
      "$ref": "#/$defs/taskInfo"
    },
    "status": {
      "type": "string",
      "description": "Current agent status",
      "enum": ["initializing", "working", "proposed", "confirmed", "blocked", "failed"]
    },
    "pipeline_id": {
      "type": "string",
      "description": "Pipeline identifier"
    },
    "progress": {
      "type": "array",
      "description": "Progress items tracking agent milestones",
      "items": {
        "$ref": "#/$defs/progressItem"
      },
      "maxItems": 10
    },
    "decisions": {
      "type": "array",
      "description": "HITL decisions encountered by the agent",
      "items": {
        "$ref": "#/$defs/decision"
      },
      "maxItems": 8
    },
    "brc_state": {
      "$ref": "#/$defs/brcState"
    },
    "key_context": {
      "type": "array",
      "description": "Key context items for state recovery",
      "items": {
        "$ref": "#/$defs/keyContext"
      },
      "maxItems": 5
    },
    "errors_encountered": {
      "type": "array",
      "description": "Errors encountered during execution",
      "items": {
        "$ref": "#/$defs/errorEncountered"
      },
      "maxItems": 5
    },
    "files_modified": {
      "type": "array",
      "description": "Files modified by the agent",
      "items": {
        "type": "string"
      },
      "maxItems": 15
    }
  },
  "additionalProperties": false,
  "$defs": {
    "meta": {
      "type": "object",
      "description": "Anchor metadata for versioning and ordering",
      "required": ["schema_version", "created_at", "updated_at", "sequence"],
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "Schema version for migrations",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "created_at": {
          "type": "string",
          "description": "ISO 8601 timestamp of creation",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "description": "ISO 8601 timestamp of last update",
          "format": "date-time"
        },
        "sequence": {
          "type": "integer",
          "description": "Monotonically incrementing sequence number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "taskInfo": {
      "type": "object",
      "description": "Information about the agent's current task",
      "required": ["id", "description", "phase"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Task identifier"
        },
        "description": {
          "type": "string",
          "description": "Task description"
        },
        "phase": {
          "type": "string",
          "description": "Pipeline phase"
        }
      },
      "additionalProperties": false
    },
    "progressItem": {
      "type": "object",
      "description": "A progress milestone",
      "required": ["step", "state", "timestamp"],
      "properties": {
        "step": {
          "type": "string",
          "description": "Step description"
        },
        "state": {
          "type": "string",
          "description": "Step state",
          "enum": ["pending", "working", "complete", "blocked"]
        },
        "detail": {
          "type": "string",
          "description": "Optional detail about the step"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "description": "A HITL decision point",
      "required": ["id", "question", "timestamp"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Decision identifier"
        },
        "question": {
          "type": "string",
          "description": "The decision question"
        },
        "answer": {
          "type": "string",
          "description": "The answer if resolved"
        },
        "decided_by": {
          "type": "string",
          "description": "Who decided"
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "brcState": {
      "type": "object",
      "description": "Broadcast-Review-Converge protocol state",
      "required": ["phase", "acks", "nacks"],
      "properties": {
        "phase": {
          "type": "string",
          "description": "BRC protocol phase",
          "enum": ["orient", "working", "proposed", "reviewing", "confirmed"]
        },
        "proposed_at": {
          "type": "string",
          "description": "ISO 8601 timestamp of proposal",
          "format": "date-time"
        },
        "acks": {
          "type": "array",
          "description": "Agent IDs that acknowledged",
          "items": {
            "type": "string"
          }
        },
        "nacks": {
          "type": "array",
          "description": "Agent IDs that rejected",
          "items": {
            "type": "string"
          }
        },
        "last_message_id": {
          "type": "string",
          "description": "Last message ID processed"
        }
      },
      "additionalProperties": false
    },
    "keyContext": {
      "type": "object",
      "description": "A key-value context item for state recovery",
      "required": ["label", "value"],
      "properties": {
        "label": {
          "type": "string",
          "description": "Context label",
          "maxLength": 50
        },
        "value": {
          "type": "string",
          "description": "Context value",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    "errorEncountered": {
      "type": "object",
      "description": "An error encountered during execution",
      "required": ["error", "timestamp"],
      "properties": {
        "error": {
          "type": "string",
          "description": "Error description",
          "maxLength": 200
        },
        "resolution": {
          "type": "string",
          "description": "How the error was resolved",
          "maxLength": 200
        },
        "timestamp": {
          "type": "string",
          "description": "ISO 8601 timestamp",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}