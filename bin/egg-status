#!/usr/bin/env python3
"""
egg-status - Unified view of all running SDLC pipelines.

Connects to the orchestrator's unified SSE endpoint and renders a
compact dashboard showing all active pipelines with real-time updates.

Runs on the host (outside the sandbox container).

In streaming mode (default), the connection is not automatically re-established
if it drops (network blip, orchestrator restart, timeout). Use --once for a
single snapshot, or wrap in a process manager / watch loop for persistence.

Usage:
    egg-status [--port PORT] [--ascii] [--once] [--all] [--verbose]

Options:
    --port PORT   Orchestrator port (default: 9849 or $EGG_ORCHESTRATOR_PORT)
    --ascii       ASCII-only characters (no Unicode)
    --once        Show current state and exit
    --all         Include completed/failed pipelines
    --verbose     Show full DAG instead of compact status
"""

import argparse
import json
import os
import re
import signal
import sys
import time
from http.client import HTTPConnection

# ANSI escape codes
CLEAR_SCREEN = "\033[2J"
MOVE_HOME = "\033[H"
RESET = "\033[0m"
DIM = "\033[2m"
BOLD = "\033[1m"
GREEN = "\033[32m"
RED = "\033[31m"
YELLOW = "\033[33m"
CYAN = "\033[36m"

IS_TTY = sys.stdout.isatty()

_ANSI_RE = re.compile(r"\033\[[0-9;?]*[A-Za-z]")


def strip_ansi(text: str) -> str:
    """Remove ANSI escape sequences from text."""
    return _ANSI_RE.sub("", text)


def _write(text: str, file=None) -> None:
    """Write text, stripping ANSI codes if not a TTY."""
    file = file or sys.stdout
    if not file.isatty():
        text = strip_ansi(text)
    file.write(text)
    file.flush()


def parse_sse_stream(response):
    """Parse an SSE stream from an HTTP response.

    Yields (event_type, data_dict) tuples.
    """
    event_type = None
    data_lines = []

    for raw_line in response:
        line = raw_line.decode("utf-8", errors="replace").rstrip("\r\n")

        if line.startswith("event: "):
            event_type = line[7:]
        elif line.startswith("data: "):
            data_lines.append(line[6:])
        elif line.startswith(":"):
            # Comment (heartbeat) — ignore
            pass
        elif line == "":
            if data_lines:
                raw = "\n".join(data_lines)
                try:
                    data = json.loads(raw)
                except json.JSONDecodeError:
                    data = {"raw": raw}
                yield (event_type or "message", data)
            event_type = None
            data_lines = []


# Status colors
_STATUS_COLORS = {
    "running": CYAN,
    "complete": GREEN,
    "failed": RED,
    "pending": DIM,
    "awaiting_human": YELLOW,
    "cancelled": RED,
}


def render_dashboard(pipelines: dict, verbose: bool = False) -> str:
    """Render the unified pipeline dashboard.

    Args:
        pipelines: dict mapping pipeline_id to its latest state dict
        verbose: Show full DAG instead of compact view

    Returns:
        Rendered dashboard string
    """
    now = time.strftime("%H:%M:%S")
    lines = []
    lines.append(f"{BOLD}egg Pipeline Status{RESET}                    Updated: {now}")
    lines.append(f"{DIM}{'━' * 56}{RESET}")

    if not pipelines:
        lines.append(f"  {DIM}No active pipelines{RESET}")
    else:
        for pid, state in sorted(pipelines.items()):
            status = state.get("status", "unknown")
            color = _STATUS_COLORS.get(status, "")
            phase = state.get("current_phase", "")
            repo = state.get("repo", "")
            branch = state.get("branch", "")
            compact = state.get("compact", "")
            progress = state.get("progress", "")

            # First line: pipeline ID, repo, compact status
            if verbose and "dag" in state:
                lines.append(
                    f"  {BOLD}{pid}{RESET}  {DIM}{repo}{RESET}  "
                    f"{color}{status}{RESET}"
                )
                lines.append(state["dag"])
            else:
                lines.append(
                    f"  {BOLD}{pid}{RESET}  {DIM}{repo}{RESET}  {compact}"
                )

            # Second line: branch and progress bar
            if branch or progress:
                branch_str = f"{DIM}{branch}{RESET}" if branch else ""
                lines.append(f"             {branch_str}  {progress}")

            lines.append("")

    lines.append(f"{DIM}{'━' * 56}{RESET}")

    active = sum(
        1 for s in pipelines.values()
        if s.get("status") not in ("complete", "failed", "cancelled")
    )
    total = len(pipelines)
    summary = f"{active} active" if active == total else f"{active} active / {total} total"
    lines.append(f"  {summary} pipelines  |  Press Ctrl+C to stop")

    return "\n".join(lines)


def display_dashboard(pipelines: dict, verbose: bool = False) -> None:
    """Display the dashboard, handling TTY vs non-TTY modes."""
    output = render_dashboard(pipelines, verbose=verbose)

    if IS_TTY:
        sys.stdout.write(MOVE_HOME + CLEAR_SCREEN)
        sys.stdout.write(output + "\n")
        sys.stdout.flush()
    else:
        plain = strip_ansi(output)
        sys.stdout.write("---\n" + plain + "\n")
        sys.stdout.flush()


def watch_all_pipelines(
    port: int = 9849,
    use_ascii: bool = False,
    once: bool = False,
    show_all: bool = False,
    verbose: bool = False,
) -> int:
    """Connect to unified SSE stream and display dashboard.

    Args:
        port: Orchestrator port
        use_ascii: Use ASCII-only characters
        once: Show current state and exit
        show_all: Include completed/failed pipelines
        verbose: Show full DAG

    Returns:
        Exit code (0 = success, 1 = error)
    """
    host = "localhost"

    # Build request path
    path = "/api/v1/pipelines/stream"
    params = []
    if use_ascii:
        params.append("ascii=true")
    if not show_all:
        params.append("active_only=true")
    else:
        params.append("active_only=false")
    if verbose:
        params.append("full_dag=true")
    if params:
        path += "?" + "&".join(params)

    conn = None
    try:
        conn = HTTPConnection(host, port, timeout=60)
        conn.request(
            "GET",
            path,
            headers={
                "Accept": "text/event-stream",
                "Cache-Control": "no-cache",
            },
        )
        response = conn.getresponse()

        if response.status != 200:
            body = response.read().decode("utf-8", errors="replace")
            try:
                err = json.loads(body)
                msg = err.get("message", body)
            except json.JSONDecodeError:
                msg = body
            _write(f"{RED}Error ({response.status}): {msg}{RESET}\n", file=sys.stderr)
            return 1

        # Track pipeline states
        pipelines: dict = {}

        for event_type, data in parse_sse_stream(response):
            if event_type == "done":
                reason = data.get("reason", "unknown")
                if reason == "timeout":
                    _write(
                        f"\n{YELLOW}Connection timed out. "
                        f"Re-run to reconnect.{RESET}\n"
                    )
                return 0

            if event_type == "snapshot":
                # Initial snapshot contains all pipelines
                for p in data.get("pipelines", []):
                    pid = p.get("pipeline_id", "unknown")
                    pipelines[pid] = p

                display_dashboard(pipelines, verbose=verbose)

                if once:
                    return 0

            else:
                # Update event for a single pipeline
                pid = data.get("pipeline_id")
                if pid:
                    # Merge into existing state
                    if pid not in pipelines:
                        pipelines[pid] = {}
                    pipelines[pid].update({
                        k: v for k, v in data.items()
                        if k not in ("data", "timestamp", "event_type",
                                     "is_terminal")
                    })

                display_dashboard(pipelines, verbose=verbose)

    except KeyboardInterrupt:
        _write(f"\n{DIM}Stopped.{RESET}\n")
        return 0
    except ConnectionRefusedError:
        _write(
            f"{RED}Cannot connect to orchestrator at localhost:{port}\n"
            f"Is the orchestrator running?{RESET}\n",
            file=sys.stderr,
        )
        return 1
    except Exception as e:
        _write(f"{RED}Connection error: {e}{RESET}\n", file=sys.stderr)
        return 1
    finally:
        if conn:
            try:
                conn.close()
            except Exception:
                pass

    return 0


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Unified view of all running SDLC pipelines",
        prog="egg-status",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=int(os.environ.get("EGG_ORCHESTRATOR_PORT", "9849")),
        help="Orchestrator port (default: 9849 or $EGG_ORCHESTRATOR_PORT)",
    )
    parser.add_argument(
        "--ascii",
        action="store_true",
        help="Use ASCII-only characters (no Unicode)",
    )
    parser.add_argument(
        "--once",
        action="store_true",
        help="Show current state and exit (no streaming)",
    )
    parser.add_argument(
        "--all",
        action="store_true",
        dest="show_all",
        help="Include completed/failed pipelines",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="Show full DAG instead of compact status",
    )

    args = parser.parse_args()

    # Handle SIGPIPE gracefully
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)

    sys.exit(
        watch_all_pipelines(
            port=args.port,
            use_ascii=args.ascii,
            once=args.once,
            show_all=args.show_all,
            verbose=args.verbose,
        )
    )


if __name__ == "__main__":
    main()
