#!/bin/bash
# egg-deploy - Deployment helper for egg
#
# Docker Compose deployment was removed in #1762. egg now deploys
# exclusively via Kubernetes. The up/down/logs/build subcommands
# are deprecated stubs that exit 2 with a migration pointer.
#
# Usage:
#   egg-deploy status   Show gateway health
#   egg-deploy init     Generate initial configuration files
#
# See: docs/guides/deployment.md

set -e

# Determine script and project directories
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored message
info() { echo -e "${BLUE}==>${NC} $1"; }
success() { echo -e "${GREEN}==>${NC} $1"; }
warn() { echo -e "${YELLOW}WARNING:${NC} $1"; }
error() { echo -e "${RED}ERROR:${NC} $1" >&2; }

# Deprecation stub for compose-based commands removed in #1762.
# egg is now deployed exclusively via Kubernetes; see docs/guides/deployment.md.
_compose_deprecated() {
    error "Docker Compose deployment was removed in #1762."
    echo "  egg now deploys exclusively via Kubernetes." >&2
    echo "  See: docs/guides/deployment.md" >&2
    echo "  See: docs/architecture/kubernetes-migration.md" >&2
    exit 2
}

# Load configuration from ~/.config/egg/config.yaml via Python helper
load_config() {
    local config_dir="${EGG_CONFIG_DIR:-$HOME/.config/egg}"
    local helper="$PROJECT_DIR/shared/egg_config/compose_config.py"

    if [ ! -f "$helper" ]; then
        error "compose_config.py helper not found at $helper"
        return 1
    fi

    if [ ! -f "$config_dir/config.yaml" ]; then
        warn "config.yaml not found in $config_dir. Run 'egg-deploy init' to create one."
        return 1
    fi

    # Read config.yaml + secrets and export as env vars
    eval "$(python3 "$helper" "$config_dir")"
}

# Show gateway status
show_status() {
    local api_port="${GATEWAY_API_PORT:-9848}"
    info "Gateway health check:"
    if health_output=$(curl -sf --max-time 5 "http://localhost:$api_port/api/v1/health" 2>/dev/null); then
        success "Gateway is healthy"
        echo "  Response: $health_output"
    else
        warn "Gateway is not responding"
    fi
}

# Initialize configuration
init_config() {
    info "Initializing egg configuration..."

    local config_dir="${EGG_CONFIG_DIR:-$HOME/.config/egg}"
    local config_file="$config_dir/config.yaml"
    local secrets_file="$config_dir/secrets.env"

    # Create config directory
    mkdir -p "$config_dir"

    # Create config.yaml if it doesn't exist
    if [ ! -f "$config_file" ]; then
        local host_uid
        host_uid=$(id -u)
        local host_gid
        host_gid=$(id -g)

        cat > "$config_file" << YAML_EOF
# Egg Configuration
# Generated by egg-deploy init

# Host identity (required for worktree bind mounts)
host_home: $HOME
host_uid: $host_uid
host_gid: $host_gid

# Git identity for commits
git_name: egg
git_email: egg@localhost

# Network ports
gateway_api_port: 9848
gateway_proxy_port: 3129
orchestrator_api_port: 9849

# MCP server (always enabled, configure port and rate limit)
mcp_server_port: 9850
mcp_rate_limit: 30

# Anthropic authentication method
anthropic_auth_method: oauth

# Image overrides (uncomment to use pre-built images)
# gateway_image: ghcr.io/jwbron/egg-gateway:latest
# orchestrator_image: ghcr.io/jwbron/egg-orchestrator:latest
# sandbox_image: ghcr.io/jwbron/egg-sandbox:latest

# Bot mode (uncomment to enable GitHub App authentication)
# gateway_bot_name: your-bot-name
# gateway_bot_branch_prefix: your-bot-name
# gateway_trusted_users: user1,user2
YAML_EOF
        info "Created config.yaml at $config_file"
    else
        warn "config.yaml already exists, not overwriting"
    fi

    # Generate launcher secret if not present
    if [ ! -f "$config_dir/launcher-secret" ]; then
        openssl rand -hex 32 > "$config_dir/launcher-secret"
        chmod 600 "$config_dir/launcher-secret"
        success "Generated launcher secret"
    fi

    # Create secrets.env template if it doesn't exist
    if [ ! -f "$secrets_file" ]; then
        cat > "$secrets_file" << 'SECRETS_EOF'
# Egg Secrets
# Generated by egg-deploy init
# chmod 600 this file

# GitHub personal access token (for git operations)
# Required scopes: repo, read:org (if accessing org repos)
GITHUB_USER_TOKEN=

# Bot GitHub token (if using GitHub App instead of PAT)
# BOT_GITHUB_TOKEN=
SECRETS_EOF
        chmod 600 "$secrets_file"
        info "Created secrets.env at $secrets_file"
    fi

    # Create repos directory
    local repos_dir="$PROJECT_DIR/repos"
    if [ ! -d "$repos_dir" ]; then
        mkdir -p "$repos_dir"
        info "Created repos directory at $repos_dir"
    fi

    echo ""
    success "Configuration initialized!"
    echo ""
    echo "Next steps:"
    echo "  1. Set your GitHub token: echo 'YOUR_TOKEN' > $config_dir/github-token && chmod 600 $config_dir/github-token"
    echo "     Or edit $secrets_file and set GITHUB_USER_TOKEN"
    echo "  2. Create repositories.yaml (see config/repositories.yaml.example)"
    echo "  3. Deploy via Kubernetes (see docs/guides/deployment.md)"
}

# Command handlers — compose-based commands are deprecated (#1762)
cmd_up()    { _compose_deprecated; }
cmd_down()  { _compose_deprecated; }
cmd_logs()  { _compose_deprecated; }
cmd_build() { _compose_deprecated; }

cmd_status() {
    load_config 2>/dev/null || true
    show_status
}

cmd_help() {
    cat << EOF
egg-deploy - Deployment helper for egg

Usage: egg-deploy <command>

Commands:
  status    Show gateway health
  init      Generate initial configuration files
  help      Show this help message

Deprecated (removed in #1762 — use Kubernetes instead):
  up        (deprecated) Was: start via Docker Compose
  down      (deprecated) Was: stop containers
  logs      (deprecated) Was: follow gateway logs
  build     (deprecated) Was: rebuild images

Examples:
  egg-deploy init        # First-time setup
  egg-deploy status      # Check health

For more information, see:
  docs/guides/deployment.md
  docs/architecture/kubernetes-migration.md
EOF
}

# Main
main() {
    local command="${1:-help}"

    case "$command" in
        up)      cmd_up ;;
        down)    cmd_down ;;
        status)  cmd_status ;;
        logs)    cmd_logs ;;
        build)   cmd_build ;;
        init)    init_config ;;
        help|--help|-h)  cmd_help ;;
        *)
            error "Unknown command: $command"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
