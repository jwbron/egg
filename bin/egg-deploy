#!/bin/bash
# egg-deploy - Unified deployment script for egg gateway and sandbox
#
# This script provides a single entry point for managing egg deployments
# using Docker Compose. It handles config generation, health checks, and
# sandbox lifecycle management.
#
# Usage:
#   egg-deploy up       Start the gateway (builds if needed)
#   egg-deploy down     Stop and remove containers
#   egg-deploy status   Show container status and health
#   egg-deploy logs     Follow gateway logs
#   egg-deploy build    Rebuild images
#   egg-deploy init     Generate initial configuration files
#
# Prerequisites:
#   - Docker and Docker Compose installed
#   - .env file configured (copy from .env.example)
#   - repositories.yaml in EGG_CONFIG_DIR

set -e

# Determine script and project directories
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
COMPOSE_FILE="$PROJECT_DIR/docker-compose.yml"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Print colored message
info() { echo -e "${BLUE}==>${NC} $1"; }
success() { echo -e "${GREEN}==>${NC} $1"; }
warn() { echo -e "${YELLOW}WARNING:${NC} $1"; }
error() { echo -e "${RED}ERROR:${NC} $1" >&2; }

# Check prerequisites
check_prerequisites() {
    if ! command -v docker &> /dev/null; then
        error "Docker is not installed. Please install Docker first."
        exit 1
    fi

    if ! docker compose version &> /dev/null 2>&1; then
        error "Docker Compose is not available. Please install Docker Compose."
        exit 1
    fi

    if [ ! -f "$COMPOSE_FILE" ]; then
        error "docker-compose.yml not found at $COMPOSE_FILE"
        exit 1
    fi
}

# Load environment file
load_env() {
    local env_file="$PROJECT_DIR/.env"

    if [ ! -f "$env_file" ]; then
        warn ".env file not found. Run 'egg-deploy init' to create one."
        return 1
    fi

    set -a
    # shellcheck source=/dev/null
    source "$env_file"
    set +a
}

# Validate configuration
validate_config() {
    local errors=0

    if [ -z "${EGG_LAUNCHER_SECRET:-}" ]; then
        error "EGG_LAUNCHER_SECRET is not set"
        errors=$((errors + 1))
    fi

    if [ -z "${GITHUB_USER_TOKEN:-}" ] && [ -z "${BOT_GITHUB_TOKEN:-}" ]; then
        warn "Neither GITHUB_USER_TOKEN nor BOT_GITHUB_TOKEN is set"
        warn "Git operations will not work without GitHub authentication"
    fi

    local config_dir="${EGG_CONFIG_DIR:-.}"
    if [ ! -f "$config_dir/repositories.yaml" ]; then
        error "repositories.yaml not found in $config_dir"
        errors=$((errors + 1))
    fi

    if [ $errors -gt 0 ]; then
        error "Configuration validation failed with $errors error(s)"
        return 1
    fi

    return 0
}

# Wait for gateway health
wait_for_health() {
    local max_wait=${1:-60}
    local elapsed=0
    local api_port="${GATEWAY_API_PORT:-9848}"

    info "Waiting for gateway to be healthy..."

    while [ $elapsed -lt $max_wait ]; do
        if curl -sf "http://localhost:$api_port/api/v1/health" &>/dev/null; then
            success "Gateway is healthy"
            return 0
        fi

        sleep 2
        elapsed=$((elapsed + 2))

        if [ $((elapsed % 10)) -eq 0 ]; then
            echo "  Still waiting... ($elapsed/$max_wait seconds)"
        fi
    done

    error "Gateway health check timed out after $max_wait seconds"
    warn "Check logs with: egg-deploy logs"
    return 1
}

# Show container status
show_status() {
    info "Container status:"
    docker compose -f "$COMPOSE_FILE" ps

    echo ""
    local api_port="${GATEWAY_API_PORT:-9848}"
    info "Gateway health check:"
    if health_output=$(curl -sf "http://localhost:$api_port/api/v1/health" 2>/dev/null); then
        success "Gateway is healthy"
        echo "  Response: $health_output"
    else
        warn "Gateway is not responding"
    fi

    echo ""
    info "Network topology:"
    local gateway_container="${COMPOSE_PROJECT_NAME:-egg}-gateway"
    if docker ps -q -f "name=$gateway_container" | grep -q .; then
        local isolated_ip
        isolated_ip=$(docker inspect "$gateway_container" \
            --format '{{with index .NetworkSettings.Networks "'"${COMPOSE_PROJECT_NAME:-egg}"'-isolated"}}{{.IPAddress}}{{end}}' 2>/dev/null)
        local external_ip
        external_ip=$(docker inspect "$gateway_container" \
            --format '{{with index .NetworkSettings.Networks "'"${COMPOSE_PROJECT_NAME:-egg}"'-external"}}{{.IPAddress}}{{end}}' 2>/dev/null)
        echo "  Gateway isolated IP: ${isolated_ip:-NOT CONNECTED}"
        echo "  Gateway external IP: ${external_ip:-NOT CONNECTED}"
    fi
}

# Initialize configuration
init_config() {
    info "Initializing egg configuration..."

    local env_file="$PROJECT_DIR/.env"

    # Create .env from example if it doesn't exist
    if [ ! -f "$env_file" ]; then
        if [ -f "$PROJECT_DIR/.env.example" ]; then
            cp "$PROJECT_DIR/.env.example" "$env_file"
            info "Created .env from .env.example"
        else
            error ".env.example not found"
            exit 1
        fi
    else
        warn ".env already exists, not overwriting"
    fi

    # Generate launcher secret if not set
    if ! grep -q "^EGG_LAUNCHER_SECRET=." "$env_file" 2>/dev/null; then
        local secret
        secret=$(openssl rand -hex 32)
        if [[ "$OSTYPE" == "darwin"* ]]; then
            sed -i '' "s/^EGG_LAUNCHER_SECRET=.*/EGG_LAUNCHER_SECRET=$secret/" "$env_file"
        else
            sed -i "s/^EGG_LAUNCHER_SECRET=.*/EGG_LAUNCHER_SECRET=$secret/" "$env_file"
        fi
        success "Generated launcher secret"
    fi

    # Set HOST_UID and HOST_GID
    local host_uid
    host_uid=$(id -u)
    local host_gid
    host_gid=$(id -g)
    if [[ "$OSTYPE" == "darwin"* ]]; then
        sed -i '' "s/^HOST_UID=.*/HOST_UID=$host_uid/" "$env_file"
        sed -i '' "s/^HOST_GID=.*/HOST_GID=$host_gid/" "$env_file"
        sed -i '' "s|^HOST_HOME=.*|HOST_HOME=$HOME|" "$env_file"
    else
        sed -i "s/^HOST_UID=.*/HOST_UID=$host_uid/" "$env_file"
        sed -i "s/^HOST_GID=.*/HOST_GID=$host_gid/" "$env_file"
        sed -i "s|^HOST_HOME=.*|HOST_HOME=$HOME|" "$env_file"
    fi
    info "Set HOST_UID=$host_uid, HOST_GID=$host_gid, HOST_HOME=$HOME"

    # Create repos directory
    local repos_dir="$PROJECT_DIR/repos"
    if [ ! -d "$repos_dir" ]; then
        mkdir -p "$repos_dir"
        info "Created repos directory at $repos_dir"
    fi

    echo ""
    success "Configuration initialized!"
    echo ""
    echo "Next steps:"
    echo "  1. Edit $env_file and set GITHUB_USER_TOKEN"
    echo "  2. Create repositories.yaml (see egg.yaml.example for format)"
    echo "  3. Run: egg-deploy up"
}

# Command handlers
cmd_up() {
    check_prerequisites
    if ! load_env; then
        error "Run 'egg-deploy init' first to create configuration"
        exit 1
    fi

    if ! validate_config; then
        exit 1
    fi

    info "Starting egg gateway..."
    docker compose -f "$COMPOSE_FILE" up -d --build

    wait_for_health 60

    echo ""
    show_status
    echo ""
    success "Gateway is ready!"
    echo ""
    echo "To start a sandbox session:"
    echo "  egg --compose"
    echo ""
    echo "To follow logs:"
    echo "  egg-deploy logs"
}

cmd_down() {
    check_prerequisites
    load_env 2>/dev/null || true

    info "Stopping egg containers..."
    docker compose -f "$COMPOSE_FILE" down --remove-orphans

    success "Containers stopped"
}

cmd_status() {
    check_prerequisites
    load_env 2>/dev/null || true

    show_status
}

cmd_logs() {
    check_prerequisites
    load_env 2>/dev/null || true

    docker compose -f "$COMPOSE_FILE" logs -f gateway
}

cmd_build() {
    check_prerequisites
    load_env 2>/dev/null || true

    info "Building egg images..."
    docker compose -f "$COMPOSE_FILE" build

    success "Build complete"
}

cmd_help() {
    cat << EOF
egg-deploy - Unified deployment script for egg

Usage: egg-deploy <command>

Commands:
  up        Start the gateway (builds if needed)
  down      Stop and remove containers
  status    Show container status and health
  logs      Follow gateway logs
  build     Rebuild images
  init      Generate initial configuration files
  help      Show this help message

Examples:
  egg-deploy init        # First-time setup
  egg-deploy up          # Start gateway
  egg-deploy status      # Check health
  egg-deploy logs        # View logs
  egg-deploy down        # Stop everything

For more information, see:
  $PROJECT_DIR/README.md
  $PROJECT_DIR/docs/guides/deployment.md
EOF
}

# Main
main() {
    local command="${1:-help}"

    case "$command" in
        up)      cmd_up ;;
        down)    cmd_down ;;
        status)  cmd_status ;;
        logs)    cmd_logs ;;
        build)   cmd_build ;;
        init)    init_config ;;
        help|--help|-h)  cmd_help ;;
        *)
            error "Unknown command: $command"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
