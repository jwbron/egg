#!/usr/bin/env bash
# egg-sdlc — Interactive SDLC pipeline CLI
#
# Host-side wrapper that launches egg-sdlc inside a container via egg --exec.
# This ensures full TTY access for interactive HITL features (editor, Claude).
#
# Usage:
#   egg-sdlc -r <repo_dir> -i <issue_number>
#   egg-sdlc [<issue_number>] [--repo <name_or_owner/repo>]
#
# If already running inside a container, delegates directly to the Python CLI.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Detect if we're already inside a container
if [ -n "${EGG_CONTAINER:-}" ] || [ -f "/.dockerenv" ]; then
    # Inside container: run directly
    exec python3 "$SCRIPT_DIR/../sandbox/bin/egg-sdlc" "$@"
fi

# Host: launch via egg --exec (6-hour timeout for long-running SDLC pipelines)
exec "$SCRIPT_DIR/egg" --timeout 360 --exec egg-sdlc "$@"
