#!/usr/bin/env python3
"""
egg-sdlc - Run the SDLC pipeline locally with Claude Code

This script enables running the full SDLC workflow locally:
- Uses nektos/act to run the same GitHub Actions workflows
- Uses local files for human interaction (instead of GitHub issue comments)
- Uses Claude Code to manage the workflow and human interaction cycle

Usage:
    egg-sdlc --issue 123                    # Start SDLC for issue #123
    egg-sdlc --issue 123 --phase plan       # Start from a specific phase
    egg-sdlc --repo owner/repo --issue 123  # Specify repository
    egg-sdlc --local                        # Run without GitHub (fully local mode)

The workflow phases are:
    1. refine  - Analyze the issue and produce analysis document
    2. plan    - Create implementation plan with tasks
    3. implement - Execute tasks and run tests
    4. pr      - Create/finalize PR for human review

Human interaction happens via local files in .egg-state/local/:
    - analysis-review.md  - Review/approve analysis (refine phase)
    - plan-review.md      - Review/approve plan (plan phase)
    - feedback.md         - Answer open-ended questions
    - decisions.md        - Make multiple-choice decisions
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

# Add parent directories to path for shared imports
SCRIPT_DIR = Path(__file__).parent.resolve()
REPO_ROOT = SCRIPT_DIR.parent
SHARED_DIR = REPO_ROOT / "shared"
SANDBOX_DIR = REPO_ROOT / "sandbox"

if str(SHARED_DIR) not in sys.path:
    sys.path.insert(0, str(SHARED_DIR))
if str(SANDBOX_DIR) not in sys.path:
    sys.path.insert(0, str(SANDBOX_DIR))


class Colors:
    """ANSI color codes for terminal output."""
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    WARNING = '\033[93m'
    FAIL = '\033[91m'
    ENDC = '\033[0m'
    BOLD = '\033[1m'
    DIM = '\033[2m'


def info(msg: str) -> None:
    """Print info message."""
    print(f"{Colors.CYAN}ℹ{Colors.ENDC} {msg}")


def success(msg: str) -> None:
    """Print success message."""
    print(f"{Colors.GREEN}✓{Colors.ENDC} {msg}")


def warn(msg: str) -> None:
    """Print warning message."""
    print(f"{Colors.WARNING}⚠{Colors.ENDC} {msg}")


def error(msg: str) -> None:
    """Print error message."""
    print(f"{Colors.FAIL}✗{Colors.ENDC} {msg}", file=sys.stderr)


def header(msg: str) -> None:
    """Print header message."""
    print(f"\n{Colors.BOLD}{Colors.HEADER}=== {msg} ==={Colors.ENDC}\n")


def check_dependencies(use_act: bool = False, local_mode: bool = False) -> bool:
    """Check if required dependencies are installed.

    Args:
        use_act: If True, check for act and docker (needed for act mode)
        local_mode: If True, skip gh check (not needed for fully local mode)
    """
    missing = []

    # git is always required
    if not shutil.which("git"):
        missing.append("git")

    # act and docker only needed with --use-act
    if use_act:
        if not shutil.which("act"):
            missing.append("act (https://github.com/nektos/act)")
        if not shutil.which("docker"):
            missing.append("docker")

    # gh CLI needed unless running fully local
    if not local_mode:
        if not shutil.which("gh"):
            missing.append("gh (GitHub CLI)")

    if missing:
        error("Missing required dependencies:")
        for dep in missing:
            print(f"  - {dep}")
        print("\nInstall missing dependencies and try again.")
        return False

    return True


def get_repo_info(repo_path: Path) -> tuple[str, str]:
    """Get repository owner and name from git remote."""
    try:
        result = subprocess.run(
            ["git", "-C", str(repo_path), "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            check=True,
        )
        url = result.stdout.strip()

        # Parse GitHub URL (HTTPS or SSH)
        if url.startswith("git@github.com:"):
            # SSH format: git@github.com:owner/repo.git
            repo_part = url.replace("git@github.com:", "").replace(".git", "")
        elif "github.com" in url:
            # HTTPS format: https://github.com/owner/repo.git
            repo_part = url.split("github.com/")[-1].replace(".git", "")
        else:
            raise ValueError(f"Unknown git remote format: {url}")

        parts = repo_part.split("/")
        if len(parts) != 2:
            raise ValueError(f"Cannot parse owner/repo from: {repo_part}")

        return parts[0], parts[1]

    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"Failed to get git remote: {e}") from e


def get_issue_details(repo: str, issue_number: int) -> dict:
    """Fetch issue details from GitHub."""
    try:
        result = subprocess.run(
            ["gh", "api", f"repos/{repo}/issues/{issue_number}"],
            capture_output=True,
            text=True,
            check=True,
        )
        return json.loads(result.stdout)
    except subprocess.CalledProcessError as e:
        raise RuntimeError(f"Failed to fetch issue #{issue_number}: {e.stderr}") from e


def setup_local_state(repo_path: Path) -> Path:
    """Set up local state directory for SDLC workflow."""
    state_dir = repo_path / ".egg-state"
    local_dir = state_dir / "local"
    contracts_dir = state_dir / "contracts"
    drafts_dir = state_dir / "drafts"
    reviews_dir = state_dir / "reviews"

    # Create directories
    for d in [local_dir, contracts_dir, drafts_dir, reviews_dir]:
        d.mkdir(parents=True, exist_ok=True)

    return local_dir


def create_local_review_file(
    local_dir: Path,
    issue_number: int,
    phase: str,
    content: str,
    next_phase: str,
) -> Path:
    """Create a local review file for human interaction."""
    if phase == "refine":
        filename = "analysis-review.md"
        title = "Analysis Review"
    elif phase == "plan":
        filename = "plan-review.md"
        title = "Plan Review"
    else:
        filename = f"{phase}-review.md"
        title = f"{phase.title()} Review"

    review_file = local_dir / filename

    review_content = f"""# {title} - Issue #{issue_number}

> **Phase**: {phase}
> **Next Phase**: {next_phase}
> **Status**: PENDING REVIEW

---

## Content to Review

{content}

---

## Your Decision

Edit this section to approve or request changes:

### Approval

To approve and advance to the {next_phase} phase, uncomment the line below:

<!-- [x] APPROVED - Advance to {next_phase} phase -->

### Request Changes

If changes are needed, uncomment and fill in below:

<!-- [x] CHANGES REQUESTED
Feedback:
- [Your feedback here]
-->

---

*Save this file after making your decision. The workflow will detect your choice.*
"""

    review_file.write_text(review_content)
    return review_file


def create_feedback_file(local_dir: Path, issue_number: int, questions: list[str]) -> Path:
    """Create a feedback file for open-ended questions."""
    feedback_file = local_dir / "feedback.md"

    content = f"""# Feedback Request - Issue #{issue_number}

The agent needs your input on the following questions.
Please provide your answers below each question.

---

"""
    for i, question in enumerate(questions, 1):
        content += f"""## Q{i}: {question}

> Your answer here

---

"""

    content += """
## Submit Feedback

When you're done answering, uncomment the line below:

<!-- [x] FEEDBACK SUBMITTED -->

---

*Save this file after adding your answers.*
"""

    feedback_file.write_text(content)
    return feedback_file


def create_decision_file(
    local_dir: Path,
    issue_number: int,
    question: str,
    options: list[str],
) -> Path:
    """Create a decision file for multiple-choice questions."""
    decision_file = local_dir / "decisions.md"

    content = f"""# Decision Required - Issue #{issue_number}

## Question

{question}

## Options

Select one option by uncommenting its line:

"""
    for i, option in enumerate(options, 1):
        content += f"<!-- [ ] Option {i}: {option} -->\n"

    content += """
## Other

If none of the above options work, uncomment and explain:

<!-- [ ] Other: [Your explanation here] -->

---

*Save this file after making your selection.*
"""

    decision_file.write_text(content)
    return decision_file


def wait_for_human_decision(
    local_dir: Path,
    filename: str,
    check_interval: int = 2,
) -> tuple[str, str | None]:
    """Wait for human to make a decision in a local file.

    Returns:
        Tuple of (decision_type, feedback) where decision_type is one of:
        - "approved": User approved
        - "changes_requested": User requested changes (feedback contains details)
        - "submitted": User submitted feedback
        - "selected": User selected an option (feedback contains option)
        - "cancelled": User cancelled or file was deleted
    """
    file_path = local_dir / filename

    try:
        mtime = file_path.stat().st_mtime
    except FileNotFoundError:
        return "cancelled", None

    info(f"Waiting for human input in: {file_path}")
    print(f"  {Colors.DIM}(Edit the file and save to continue, Ctrl+C to cancel){Colors.ENDC}")

    initial_mtime = mtime

    try:
        while True:
            time.sleep(check_interval)

            try:
                current_mtime = file_path.stat().st_mtime
            except FileNotFoundError:
                return "cancelled", None

            if current_mtime <= initial_mtime:
                continue

            # File was modified, check for decisions
            content = file_path.read_text()

            # Check for approval
            if "[x] APPROVED" in content or "[ x ] APPROVED" in content.replace(" ", ""):
                return "approved", None

            # Check for changes requested
            if "[x] CHANGES REQUESTED" in content:
                # Extract feedback
                lines = content.split("\n")
                feedback_lines = []
                in_feedback = False
                for line in lines:
                    if "CHANGES REQUESTED" in line:
                        in_feedback = True
                        continue
                    if in_feedback:
                        if line.startswith("-->"):
                            break
                        if line.strip().startswith("-"):
                            feedback_lines.append(line.strip()[1:].strip())
                feedback = "\n".join(feedback_lines) if feedback_lines else "No specific feedback provided"
                return "changes_requested", feedback

            # Check for feedback submitted
            if "[x] FEEDBACK SUBMITTED" in content:
                return "submitted", content

            # Check for option selected
            for i in range(1, 10):
                if f"[x] Option {i}:" in content:
                    # Extract the option text
                    for line in content.split("\n"):
                        if f"[x] Option {i}:" in line:
                            option = line.split(f"[x] Option {i}:")[-1].strip()
                            if option.endswith("-->"):
                                option = option[:-3].strip()
                            return "selected", option

            # Check for "Other" selected
            if "[x] Other:" in content:
                for line in content.split("\n"):
                    if "[x] Other:" in line:
                        option = line.split("[x] Other:")[-1].strip()
                        if option.endswith("-->"):
                            option = option[:-3].strip()
                        return "selected", f"Other: {option}"

            # Update mtime for next iteration (in case user is still editing)
            initial_mtime = current_mtime
    except KeyboardInterrupt:
        warn("\nCancelled by user")
        return "cancelled", None


def run_phase_with_act(
    repo_path: Path,
    phase: str,
    issue_number: int,
    branch_name: str,
    env_vars: dict,
) -> bool:
    """Run a SDLC phase using nektos/act.

    Returns True if successful, False otherwise.
    """
    header(f"Running {phase} phase with act")

    # Build act command
    cmd = [
        "act",
        "-W", ".github/workflows/sdlc-work-loop.yml",
        "-j", "work",
        "--env", f"EGG_PIPELINE_PHASE={phase}",
        "--env", f"EGG_ISSUE_NUMBER={issue_number}",
        "--env", f"EGG_BRANCH_NAME={branch_name}",
    ]

    # Add environment variables
    for key, value in env_vars.items():
        cmd.extend(["--env", f"{key}={value}"])

    # Add secrets if available
    github_token = os.environ.get("GITHUB_TOKEN")
    if github_token:
        cmd.extend(["--secret", f"GITHUB_TOKEN={github_token}"])

    info(f"Running: {' '.join(cmd[:5])}...")

    # 30 minutes timeout for workflow execution
    result = subprocess.run(
        cmd,
        cwd=repo_path,
        check=False,  # Don't raise on non-zero exit
        timeout=1800,  # 30 minutes
    )
    return result.returncode == 0


def run_phase_with_claude(
    repo_path: Path,
    phase: str,
    issue_number: int,
    branch_name: str,
    issue_data: dict,
) -> bool:
    """Run a SDLC phase using Claude Code directly (without act).

    This is the preferred mode for local development as it:
    - Provides interactive feedback
    - Uses the same Claude Code instance for the whole workflow
    - Enables file-based human interaction

    Returns True if successful, False otherwise.
    """
    header(f"Running {phase} phase")

    # Build the prompt using the same script as CI
    prompt_script = repo_path / "action" / "build-sdlc-prompt.sh"

    if not prompt_script.exists():
        error(f"Prompt script not found: {prompt_script}")
        return False

    # Set environment for prompt builder
    env = os.environ.copy()
    env.update({
        "GITHUB_REPOSITORY": f"{issue_data.get('repository', {}).get('full_name', 'unknown/repo')}",
        "EGG_ISSUE_NUMBER": str(issue_number),
        "EGG_PIPELINE_PHASE": phase,
        "EGG_BRANCH_NAME": branch_name,
        "EGG_REPO_PATH": str(repo_path),
        # Disable GITHUB_OUTPUT for local execution
        "GITHUB_OUTPUT": "/dev/null",
    })

    # For local mode, we don't run the full workflow
    # Instead, we provide instructions for the human to run Claude Code manually
    info(f"Phase: {phase}")
    info(f"Issue: #{issue_number} - {issue_data.get('title', 'Unknown')}")
    info(f"Branch: {branch_name}")

    # Create state directories
    state_dir = repo_path / ".egg-state"
    local_dir = state_dir / "local"
    local_dir.mkdir(parents=True, exist_ok=True)

    # Create a prompt file for the current phase
    prompt_file = local_dir / f"{phase}-prompt.md"

    prompt_content = f"""# SDLC {phase.title()} Phase - Issue #{issue_number}

## Issue: {issue_data.get('title', 'Unknown')}

{issue_data.get('body', 'No description')}

## Instructions

You are in the **{phase}** phase of the SDLC pipeline.

### Your Task

"""

    if phase == "refine":
        prompt_content += """
1. Analyze the issue and understand the problem
2. Research the codebase to identify relevant files
3. Consider multiple approaches
4. Write your analysis to `.egg-state/drafts/{issue_number}-analysis.md`

When complete, save your analysis and the human will review it.
"""
    elif phase == "plan":
        prompt_content += """
1. Review the analysis (if available)
2. Break down the work into phases and tasks
3. Define acceptance criteria for each task
4. Write your plan to `.egg-state/drafts/{issue_number}-plan.md`

Include a YAML appendix with structured task definitions.
When complete, save your plan and the human will review it.
"""
    elif phase == "implement":
        prompt_content += """
1. Review the plan and contract state
2. Implement each task
3. Run tests to verify
4. Commit changes with descriptive messages

Use `egg-contract` commands to track progress:
- `egg-contract show` - View contract state
- `egg-contract add-commit --task task-1 --commit <sha>` - Link commit
"""
    elif phase == "pr":
        prompt_content += """
1. Ensure all tasks are complete
2. Push final changes
3. Create or update the PR

The human will review and merge the PR.
"""

    prompt_file.write_text(prompt_content.format(issue_number=issue_number))

    success(f"Created prompt file: {prompt_file}")
    print(f"\n{Colors.BOLD}Next steps:{Colors.ENDC}")
    print("  1. Open Claude Code in the repository")
    print(f"  2. Read the prompt file: {prompt_file.relative_to(repo_path)}")
    print(f"  3. Follow the instructions to complete the {phase} phase")
    print("  4. Save any outputs to the appropriate .egg-state/ files")

    return True


def run_local_sdlc(
    repo_path: Path,
    issue_number: int,
    starting_phase: str = "refine",
    use_act: bool = False,
    repo: str | None = None,
) -> int:
    """Run the full SDLC workflow locally.

    Args:
        repo_path: Path to the repository
        issue_number: GitHub issue number
        starting_phase: Phase to start from
        use_act: Whether to use nektos/act (True) or Claude Code directly (False)
        repo: Repository in owner/repo format (optional)

    Returns:
        Exit code (0 for success, non-zero for failure)
    """
    header("egg-sdlc: Local SDLC Workflow")

    # Get repository info
    if repo:
        parts = repo.split("/")
        if len(parts) != 2:
            error("--repo must be in owner/repo format (e.g., 'myorg/myrepo')")
            return 1
        owner, name = parts
    else:
        try:
            owner, name = get_repo_info(repo_path)
        except RuntimeError as e:
            error(str(e))
            return 1

    repo_full = f"{owner}/{name}"
    info(f"Repository: {repo_full}")

    # Fetch issue details
    try:
        issue_data = get_issue_details(repo_full, issue_number)
        issue_data["repository"] = {"full_name": repo_full}
    except RuntimeError as e:
        if "--local" in sys.argv:
            # Allow running without GitHub in local mode
            warn(f"Could not fetch issue: {e}")
            issue_data = {
                "number": issue_number,
                "title": f"Local Issue #{issue_number}",
                "body": "Running in local mode without GitHub integration.",
                "repository": {"full_name": repo_full},
            }
        else:
            error(str(e))
            return 1

    info(f"Issue: #{issue_number} - {issue_data.get('title', 'Unknown')}")

    # Set up branch name
    branch_name = f"egg/issue-{issue_number}"
    info(f"Branch: {branch_name}")

    # Set up local state
    local_dir = setup_local_state(repo_path)
    info(f"Local state: {local_dir}")

    # Define phase order
    phases = ["refine", "plan", "implement", "pr"]
    start_index = phases.index(starting_phase)

    # Run phases
    for phase in phases[start_index:]:
        if use_act:
            # Run with nektos/act
            env_vars = {
                "GITHUB_REPOSITORY": repo_full,
            }
            success_flag = run_phase_with_act(
                repo_path, phase, issue_number, branch_name, env_vars
            )
        else:
            # Run with Claude Code (interactive mode)
            success_flag = run_phase_with_claude(
                repo_path, phase, issue_number, branch_name, issue_data
            )

        if not success_flag:
            error(f"Phase {phase} failed")
            return 1

        # For non-act mode, we handle one phase at a time
        if not use_act:
            print(f"\n{Colors.BOLD}Phase {phase} setup complete.{Colors.ENDC}")
            print("Complete the phase, then run this command again to continue.")
            break

        # Human review gate (for refine and plan phases)
        if phase in ["refine", "plan"]:
            # Get the draft content
            if phase == "refine":
                draft_file = repo_path / ".egg-state" / "drafts" / f"{issue_number}-analysis.md"
                next_phase = "plan"
            else:
                draft_file = repo_path / ".egg-state" / "drafts" / f"{issue_number}-plan.md"
                next_phase = "implement"

            if draft_file.exists():
                content = draft_file.read_text()
                review_file = create_local_review_file(
                    local_dir, issue_number, phase, content, next_phase
                )
                success(f"Created review file: {review_file}")

                # Wait for human decision
                decision, feedback = wait_for_human_decision(
                    local_dir, review_file.name
                )

                if decision == "approved":
                    success(f"Phase {phase} approved, advancing to {next_phase}")
                elif decision == "changes_requested":
                    warn(f"Changes requested for {phase} phase")
                    print(f"Feedback: {feedback}")
                    # In a full implementation, we would re-run the phase with feedback
                    return 1
                else:
                    error(f"Unexpected decision: {decision}")
                    return 1
            else:
                warn(f"No draft file found for {phase} phase")

    success("SDLC workflow complete!")
    return 0


def main() -> int:
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description="Run the SDLC pipeline locally with Claude Code",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        "--issue", "-i",
        type=int,
        required=False,
        help="GitHub issue number",
    )
    parser.add_argument(
        "--phase", "-p",
        choices=["refine", "plan", "implement", "pr"],
        default="refine",
        help="Phase to start from (default: refine)",
    )
    parser.add_argument(
        "--repo", "-r",
        help="Repository in owner/repo format (auto-detected from git remote)",
    )
    parser.add_argument(
        "--path",
        type=Path,
        default=Path.cwd(),
        help="Path to repository (default: current directory)",
    )
    parser.add_argument(
        "--use-act",
        action="store_true",
        help="Use nektos/act to run GitHub Actions locally",
    )
    parser.add_argument(
        "--local",
        action="store_true",
        help="Run in fully local mode (no GitHub integration)",
    )
    parser.add_argument(
        "--check-deps",
        action="store_true",
        help="Check dependencies and exit",
    )

    args = parser.parse_args()

    # Determine local_mode from args
    local_mode = getattr(args, 'local', False)

    # Check dependencies if requested or if using act
    if args.check_deps:
        if not check_dependencies(use_act=args.use_act, local_mode=local_mode):
            return 1
        success("All dependencies are installed")
        return 0

    # Always check dependencies for the mode we're running in
    if not check_dependencies(use_act=args.use_act, local_mode=local_mode):
        return 1

    # Require issue number for running the workflow
    if args.issue is None:
        error("--issue is required")
        parser.print_usage()
        return 1

    # Run the SDLC workflow
    return run_local_sdlc(
        repo_path=args.path.resolve(),
        issue_number=args.issue,
        starting_phase=args.phase,
        use_act=args.use_act,
        repo=args.repo,
    )


if __name__ == "__main__":
    sys.exit(main())
